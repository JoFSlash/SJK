// Generated by scripts/blade_signatures.py from world_shift.glsl: edit that file and run the
// script again.
// @part Climates
// @part Sparks
// @room 10
// @solid 1
// @palette {"corona.rim_cool":[0.35,0.20,0.55],"corona.rim_hot":[0.90,0.60,0.50],"corona.inner":[1.0,0.92,0.85],"core.white":[1.0,0.98,0.95],"core.fringe_cool":[0.50,0.70,1.0],"core.fringe_hot":[1.0,0.65,0.35],"light.color":[0.95,0.75,0.60],"trail":[0.90,0.70,0.60]}

// World Shift: a blade that carries the climates of the galaxy's worlds, six seconds each: Mustafar
// (a molten blade under a cracked black crust, running with lava drips and fire), Hoth (a faceted
// ice crystal with frost spikes in a swirling blizzard), Kamino (a storm blade wrapped in lightning
// with churning sea water, storm cloud and driving rain), Tatooine (a golden blade in a whirling
// vortex of sand and wind), Crait (white salt crust cracking to show the red beneath, rock shards
// drifting round it) and Mon Cala (a flowing column of water with spiralling streams and spray).
// Each change is an event: the old climate strains, then bursts off the blade in a flash with shock
// rings and its debris flung out all round, and the new one condenses onto it. Swings stoke it;
// a clash flashes the ruling climate.
// ---- the cycle: 0 Mustafar, 1 Hoth, 2 Kamino, 3 Tatooine, 4 Crait, 5 Mon Cala ----
const WS_P: f32 = 6.0;

fn ws_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn ws_cur() -> f32 {
    return glsl_mod(floor(uTime / WS_P), 6.0);
}

fn ws_prev() -> f32 {
    return glsl_mod(floor(uTime / WS_P) + 5.0, 6.0);
}

fn ws_lt() -> f32 {
    return fract(uTime / WS_P) * WS_P;
}

// did the last change happen while the blade was lit? (no burst right after ignition)
fn ws_boom() -> f32 {
    return select(0.0, 1.0, uAge > ws_lt() + 0.05);
}

// the new climate condensing onto the blade (0..1)
fn ws_form() -> f32 {
    return select(1.0, smoothstep(0.12, 1.1, ws_lt()), ws_boom() > 0.5);
}

// the ruling climate straining just before it bursts
fn ws_charge() -> f32 {
    return smoothstep(WS_P - 0.8, WS_P, ws_lt());
}

fn ws_glow(k: f32) -> vec3<f32> {
    return select(select(select(select(select(vec3<f32>(0.15, 0.62, 0.95), vec3<f32>(1.0, 0.14, 0.1), k < 4.5), vec3<f32>(1.0, 0.66, 0.25), k < 3.5), vec3<f32>(0.35, 0.55, 1.0), k < 2.5), vec3<f32>(0.45, 0.8, 1.0), k < 1.5), vec3<f32>(1.0, 0.36, 0.05), k < 0.5);
}

// a blade body: white-hot core, coloured glow
fn ws_core(d: f32, px: f32, w: f32, hot: vec3<f32>, glow_: vec3<f32>, gain: f32) -> vec3<f32> {
    // the blade itself is Sol's glow and core from the file (sig_glow, sig_core)
    return vec3<f32>(0.0);
}

// the ray's distance to a ring of radius R round the blade at height y
fn ws_ring(ro: vec3<f32>, rd: vec3<f32>, y: f32, R: f32) -> f32 {
    var best: f32 = 1.0e3;
    let h = rayAt(ro, rd, y);
    if h.z > 0.0 {
        best = hideD(abs(length(h.xy) - R), behindBlade(ro, rd, h.z));
    }
    let a = dot(rd.xz, rd.xz);
    let b = dot(ro.xz, rd.xz);
    let c = dot(ro.xz, ro.xz) - R * R;
    let dsc = b * b - a * c;
    if dsc > 0.0 && a > 1.0e-6 {
        let q = sqrt(dsc);
        let t0 = (-b - q) / a;
        let t1 = (-b + q) / a;
        if t0 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t0 - y), behindBlade(ro, rd, t0)));
        }
        if t1 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t1 - y), behindBlade(ro, rd, t1)));
        }
    }
    return best;
}

// fire colour by heat 0..1
fn ws_fire(h: f32) -> vec3<f32> {
    var c = mix(vec3<f32>(0.6, 0.05, 0.0), vec3<f32>(1.0, 0.38, 0.04), smoothstep(0.0, 0.4, h));
    c = mix(c, vec3<f32>(1.0, 0.75, 0.3), smoothstep(0.4, 0.75, h));
    return mix(c, vec3<f32>(1.0, 0.95, 0.8), smoothstep(0.75, 1.0, h));
}

// a wind streak: an arc of 5 pieces sweeping round the blade; returns its light weight
fn ws_wind(ro: vec3<f32>, rd: vec3<f32>, r: f32, a: f32, y: f32, span: f32, rise: f32, px: f32) -> f32 {
    var best: f32 = 1.0e3;
    var bf: f32 = 0.0;
    var s: f32;
    var prev = around(r, a, y);
    for (var j = 1; j <= 5; j++) {
        let f = f32(j) / 5.0;
        let q = around(r * (1.0 + 0.08 * f), a + span * f, y + rise * f);
        let dd = raySeg(ro, rd, prev, q, &s);
        if dd < best {
            best = dd;
            bf = (f32(j) - 1.0 + s) / 5.0;
        }
        prev = q;
    }
    let taper = sin(3.1416 * bf) * (0.4 + 0.6 * bf);
    return (halo(best, max(0.035, px)) * 1.0 + halo(best, 0.2) * 0.25) * taper;
}

// soft clouds of each climate round the blade: fire tongues (Mustafar), snow mist (Hoth),
// storm cloud (Kamino), sand (Tatooine), red dust (Crait) and spray (Mon Cala), each puff a
// soft piece facing the camera, drifting with its world's weather
fn ws_puffs(ro: vec3<f32>, rd: vec3<f32>, k: f32, top: f32, form: f32, st: f32, ch: f32) -> vec3<f32> {
    let t = uTime;
    var ta: f32;
    var col: vec3<f32> = vec3<f32>(0.0);
    for (var i = 0; i < 20; i++) {
        let fi = f32(i);
        let rate = select(select(select(select(select(0.4, 0.18, k < 4.5), 0.35, k < 3.5), 0.12, k < 2.5), 0.25, k < 1.5), 0.9, k < 0.5);
        let f = fract(t * rate * (0.7 + 0.6 * h11(fi * 2.3)) + h11(fi * 5.9));
        let cy = floor(t * rate * (0.7 + 0.6 * h11(fi * 2.3)) + h11(fi * 5.9));
        let y0 = (0.03 + 0.92 * h11(fi * 3.7 + cy)) * top;
        var r: f32;
        var a: f32;
        var yy: f32;
        var w: f32;
        var c: vec3<f32>;
        if k < 0.5 {
            // fire tongues licking up off the blade
            r = 0.6 + 1.6 * f;
            a = h11(fi * 1.3 + cy);
            yy = y0 + 3.0 * f;
            w = 0.5 * (1.0 - 0.5 * f) + 0.25;
            c = ws_fire(1.0 - f * 0.9) * 1.8;
        } else if k < 1.5 {
            r = 1.0 + 2.6 * h11(fi * 4.1 + cy);
            a = h11(fi * 1.3 + cy) + t * 0.12;
            yy = y0 + 0.6 * sin(t + fi);
            w = 0.9 + 0.6 * h11(fi);
            c = vec3<f32>(0.6, 0.8, 1.0) * 0.5;
        } else if k < 2.5 {
            r = 1.4 + 2.4 * h11(fi * 4.1 + cy);
            a = h11(fi * 1.3 + cy) + t * 0.05;
            yy = y0;
            w = 1.0 + 0.8 * h11(fi);
            c = mix(vec3<f32>(0.12, 0.16, 0.3), vec3<f32>(0.5, 0.65, 1.0), 0.5 + 0.5 * sin(t * 9.0 + fi * 3.0) * step(0.85, h11(floor(t * 6.0) + fi)));
        } else if k < 3.5 {
            r = 0.9 + 3.0 * f;
            a = h11(fi * 1.3 + cy) + f * 0.8;
            yy = y0 + 0.8 * f;
            w = 0.6 + 0.6 * f;
            c = vec3<f32>(1.0, 0.66, 0.3) * 0.6;
        } else if k < 4.5 {
            r = 0.9 + 1.6 * f;
            a = h11(fi * 1.3 + cy) + 0.1 * f;
            yy = y0 + 1.0 * f;
            w = 0.5 + 0.5 * f;
            c = vec3<f32>(0.8, 0.12, 0.08) * 0.6;
        } else {
            r = 0.7 + 1.2 * f;
            a = h11(fi * 1.3 + cy) - f * 0.6;
            yy = y0 + 1.6 * f;
            w = 0.35 + 0.35 * f;
            c = vec3<f32>(0.4, 0.8, 1.0) * 0.6;
        }
        let p = around(r, a, yy);
        let dd = rayPt(ro, rd, p, &ta);
        if dd > 3.5 {
            continue;
        }
        col += c * (halo(dd, w) * 0.6 + halo(dd, w * 2.2) * 0.12) * sin(3.1416 * f) * form * (1.0 + 0.5 * st + 0.5 * ch);
    }
    return col;
}

// ======== MUSTAFAR: molten blade, black crust (solid pass), fire, drips ========
fn ws_lava(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, form: f32, ch: f32, st: f32, fx: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    var ta: f32;
    var col = ws_core(d, px, 0.42, vec3<f32>(1.0, 0.85, 0.5), vec3<f32>(1.0, 0.36, 0.05), 1.0 + ch + 0.3 * st);
    col += ws_puffs(ro, rd, 0.0, top, form, st, ch) * fx;
    // molten drips running down the blade and dropping away from it
    for (var i = 0; i < 9; i++) {
        let fi = f32(i);
        let cyc = t * 0.32 + h11(fi * 3.1);
        let k = floor(cyc);
        let f = fract(cyc);
        let y0 = (0.25 + 0.7 * h11(k * 1.9 + fi)) * top;
        let a = h11(fi * 5.3 + k);
        let off = max(f - 0.5, 0.0);
        let yy = y0 - 5.0 * f * f;
        let rr = 0.66 + 6.0 * off * off;
        let p1 = around(rr, a, yy);
        let p0 = around(0.66 + 6.0 * max(off - 0.08, 0.0) * max(off - 0.08, 0.0), a, yy + 0.6 + 1.2 * f);
        let dd = raySeg(ro, rd, p0, p1, &s);
        let life = smoothstep(0.0, 0.1, f) * (1.0 - smoothstep(0.75, 1.0, f)) * form;
        let dh = rayPt(ro, rd, p1, &ta);
        col += (vec3<f32>(1.0, 0.55, 0.12) * halo(dd, max(0.05, px)) * 1.2 + vec3<f32>(1.0, 0.8, 0.4) * halo(dh, max(0.11, px)) * 1.8 + vec3<f32>(1.0, 0.3, 0.03) * halo(dd, 0.45) * 0.3) * life * fx;
    }
    // embers rising
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let f = fract(t * (0.2 + 0.1 * h11(fi * 2.9)) + h11(fi * 5.1));
        let p = around(0.8 + 3.0 * h11(fi * 3.7) * f, h11(fi * 1.9) + 0.15 * sin(t + fi), f * (top + 2.0));
        let dd = rayPt(ro, rd, p, &ta);
        col += vec3<f32>(1.0, 0.5, 0.1) * (halo(dd, max(0.06, px)) * 1.8 + halo(dd, 0.3) * 0.15) * smoothstep(0.0, 0.1, f) * (1.0 - smoothstep(0.7, 1.0, f)) * form * fx;
    }
    return col;
}

// ======== HOTH: a hexagonal ice crystal, frost spikes, blizzard ========
fn ws_ice(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, form: f32, ch: f32, st: f32, fx: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    var ta: f32;
    var col = ws_core(d, px, 0.32, vec3<f32>(0.9, 0.97, 1.0), vec3<f32>(0.4, 0.75, 1.0), 1.0 + ch + 0.3 * st);
    let yc = -0.3 + (top + 0.3) * form;
    let jit = ch * 0.04 * sin(t * 70.0);
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if fx <= 0.0 || far > 8.0 {
        return col;
    }
    // frost spikes jutting from the crystal
    for (var i = 0; i < 12; i++) {
        let fi = f32(i);
        let y0 = (0.06 + 0.86 * h11(fi * 2.7)) * top;
        if y0 > yc - 1.0 {
            continue;
        }
        let a = h11(fi * 6.1) + fi * 0.37;
        let ln = (0.5 + 1.1 * h11(fi * 1.3)) * form * (1.0 + 0.3 * st);
        let b0 = around(0.55, a, y0);
        let b1 = around(0.55 + ln, a + 0.03, y0 + ln * 0.7);
        let dd = raySeg(ro, rd, b0, b1, &s);
        col += (vec3<f32>(0.95, 1.0, 1.0) * halo(dd, max(0.04 * (1.0 - s) + 0.012, px)) * 1.4 + vec3<f32>(0.4, 0.75, 1.0) * halo(dd, 0.25) * 0.3) * fx;
    }
    // blizzard: wind streaks sweeping round the blade
    let wr = 1.0 + 2.5 * (1.0 - form);
    for (var i = 0; i < 7; i++) {
        let fi = f32(i);
        let cyc = t * 0.5 + h11(fi * 4.3);
        let k = floor(cyc);
        let f = fract(cyc);
        let r = (1.3 + 2.4 * h11(fi * 2.2 + k)) * wr;
        let y = (0.05 + 0.85 * h11(fi * 1.7 + k * 3.1)) * top;
        let a = h11(fi * 8.3 + k) + f * 0.9;
        col += vec3<f32>(0.85, 0.93, 1.0) * ws_wind(ro, rd, r, a, y, 0.22, 1.2, px) * sin(3.1416 * f) * (0.7 + 0.5 * st) * form * fx;
    }
    // snow whirling round
    for (var i = 0; i < 30; i++) {
        let fi = f32(i);
        let r = (1.0 + 3.6 * h11(fi * 3.3)) * wr;
        let a = h11(fi * 7.7) + t * (0.35 + 0.25 * h11(fi * 1.1));
        let yy = glsl_mod(h11(fi * 5.9) * (top + 2.0) - t * (1.2 + 1.5 * h11(fi * 2.4)), top + 2.0) - 1.0;
        let dd = rayPt(ro, rd, around(r, a, yy), &ta);
        col += vec3<f32>(0.92, 0.97, 1.0) * (halo(dd, max(0.05, px)) * 1.4 + halo(dd, 0.2) * 0.1) * form * fx;
    }
    // snow mist
    col += ws_puffs(ro, rd, 1.0, top, form, st, ch) * fx;
    return col;
}

// ======== KAMINO: lightning wrapping the blade, churning sea, storm cloud, rain ========
fn ws_storm(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, form: f32, ch: f32, st: f32, fx: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    var fl: f32 = 0.0;
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        let k = floor(t * 6.0 + fi * 0.37);
        fl += step(0.3, h11(k * 1.7 + fi)) * exp(-fract(t * 6.0 + fi * 0.37) * 4.0);
    }
    var col = ws_core(d, px, 0.34, vec3<f32>(0.88, 0.93, 1.0), vec3<f32>(0.3, 0.55, 1.0), 1.0 + ch + 0.25 * fl + 0.3 * st);
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if fx <= 0.0 || far > 8.0 {
        return col;
    }
    // lightning wrapping round the blade in 3D
    if far < 5.0 {
        for (var i = 0; i < 3; i++) {
            let fi = f32(i);
            let k = floor(t * 6.0 + fi * 0.37);
            let on = step(0.3, h11(k * 1.7 + fi)) * (0.6 + 0.4 * ch);
            if on < 0.01 {
                continue;
            }
            let y0 = (0.06 + 0.72 * h11(k * 2.3 + fi * 3.1)) * top;
            let dy = (3.0 + 4.0 * h11(k * 3.9 + fi)) * (0.6 + 0.4 * form);
            let a = h11(k * 5.1 + fi);
            let reach = (1.6 + 1.4 * h11(k * 0.7 + fi)) * (1.0 + 0.4 * st);
            let A = around(0.35, a, y0);
            let M = around(reach, a + 0.25, y0 + dy * 0.5);
            let C = around(0.35, a + 0.5, y0 + dy);
            let bd = min(bolt3(ro, rd, A, M, k + fi * 11.0, 0.3), bolt3(ro, rd, M, C, k + fi * 11.0 + 0.5, 0.3));
            col += boltLight(bd, vec3<f32>(0.45, 0.6, 1.0), px) * on * 1.3 * form;
        }
    }
    // the churning sea round the blade and the storm cloud beyond (marched)
    col += ws_puffs(ro, rd, 2.0, top, form, st, ch) * fx;
    // driving rain
    for (var i = 0; i < 26; i++) {
        let fi = f32(i);
        let r = (0.8 + 3.8 * h11(fi * 3.3)) * (1.0 + 1.5 * (1.0 - form));
        let a = h11(fi * 7.7);
        let yy = top + 2.0 - glsl_mod(h11(fi * 5.9) * 40.0 + t * (20.0 + 6.0 * h11(fi)), top + 4.0);
        let p = around(r, a, yy);
        let dd = raySeg(ro, rd, p, p + vec3<f32>(0.2, 1.4, 0.1), &s);
        col += vec3<f32>(0.7, 0.82, 1.0) * (halo(dd, max(0.02, px)) * 0.9 + halo(dd, 0.12) * 0.12) * form;
    }
    return col;
}

// ======== TATOOINE: golden blade in a vortex of sand and wind ========
fn ws_sand(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, form: f32, ch: f32, st: f32, fx: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    var ta: f32;
    var col = ws_core(d, px, 0.36, vec3<f32>(1.0, 0.93, 0.72), vec3<f32>(1.0, 0.6, 0.2), 1.0 + ch + 0.3 * st);
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if fx <= 0.0 || far > 8.0 {
        return col;
    }
    let wr = 1.0 + 2.0 * (1.0 - form);
    // the sand vortex (marched)
    col += ws_puffs(ro, rd, 3.0, top, form, st, ch) * fx;
    // wind streaks whipping round
    for (var i = 0; i < 8; i++) {
        let fi = f32(i);
        let cyc = t * 0.8 + h11(fi * 4.3);
        let k = floor(cyc);
        let f = fract(cyc);
        let r = (0.9 + 3.0 * h11(fi * 2.2 + k)) * wr;
        let y = (0.03 + 0.9 * h11(fi * 1.7 + k * 3.1)) * top;
        let a = h11(fi * 8.3 + k) + f * 1.1;
        col += vec3<f32>(1.0, 0.9, 0.72) * ws_wind(ro, rd, r, a, y, 0.28, 0.8, px) * sin(3.1416 * f) * (0.8 + 0.6 * st) * form;
    }
    // glinting grains
    for (var i = 0; i < 24; i++) {
        let fi = f32(i);
        let r = (0.8 + 3.5 * h11(fi * 3.3)) * wr;
        let a = h11(fi * 7.7) + t * (0.5 + 0.3 * h11(fi * 1.1)) / (0.4 + 0.25 * r);
        let yy = glsl_mod(h11(fi * 5.9) * (top + 2.0) + t * (0.8 + h11(fi * 2.4)), top + 2.0) - 1.0;
        let dd = rayPt(ro, rd, around(r, a, yy), &ta);
        col += vec3<f32>(1.0, 0.85, 0.6) * halo(dd, max(0.05, px)) * 1.5 * (0.5 + 0.5 * sin(t * 9.0 + fi * 2.0)) * form;
    }
    return col;
}

// ======== CRAIT: white salt crust (solid pass) over red, rock shards, red dust ========
fn ws_shard(fi: f32, form: f32, b0: ptr<function, vec3<f32>>) -> vec3<f32> {
    let t = uTime;
    let r = (2.0 + 2.8 * h11(fi * 3.3)) * (1.0 + 1.0 * (1.0 - form));
    let c = around(r, h11(fi * 7.1) + t * 0.04 * (1.0 + h11(fi)), (0.08 + 0.84 * h11(fi * 1.9)) * uLength + 0.4 * sin(t * 0.6 + fi));
    let dir = normalize(vec3(sin(t * 0.7 + fi), cos(t * 0.5 + fi * 2.0), sin(t * 0.6 + fi * 3.0)));
    let ln = 0.5 + 0.6 * h11(fi * 5.5);
    (*b0) = c - dir * ln;
    return c + dir * ln;
}

fn ws_rock(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, form: f32, ch: f32, st: f32, fx: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    let pul = 0.85 + 0.15 * sin(t * 2.0);
    var col = ws_core(d, px, 0.42, vec3<f32>(1.0, 0.86, 0.84), vec3<f32>(1.0, 0.13, 0.1), (1.1 + 1.5 * ch + 0.3 * st) * pul);
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if fx <= 0.0 || far > 8.0 {
        return col;
    }
    // red salt dust rising off the cracks (marched)
    col += ws_puffs(ro, rd, 4.0, top, form, st, ch) * fx;
    // red light round the floating shards (the shards themselves are in the solid pass)
    for (var i = 0; i < 9; i++) {
        let fi = f32(i);
        var b0: vec3<f32>;
        let b1 = ws_shard(fi, form, &b0);
        if b1.y > top {
            continue;
        }
        let dd = raySeg(ro, rd, b0, b1, &s);
        col += vec3<f32>(1.0, 0.15, 0.1) * halo(dd, 0.45) * 0.35 * form;
    }
    return col;
}

// ======== MON CALA: a flowing column of water, spiralling streams, spray ========
fn ws_water(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, form: f32, ch: f32, st: f32, fx: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    var ta: f32;
    var col = ws_core(d, px, 0.3, vec3<f32>(0.85, 1.0, 1.0), vec3<f32>(0.15, 0.6, 0.95), 1.0 + ch + 0.3 * st);
    // the flowing column (marched): water racing up, with bright caustic ridges
    col += ws_puffs(ro, rd, 5.0, top, form, st, ch) * fx;
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if fx <= 0.0 || far > 8.0 {
        return col;
    }
    // three streams of water spiralling up round the blade
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        var best: f32 = 1.0e3;
        var by: f32 = 0.0;
        let r = (1.45 + 0.2 * sin(t * 1.3 + fi * 2.0)) * (1.0 + 2.0 * (1.0 - form)) * (1.0 + 0.2 * st);
        var prev = around(r * 0.6, fi / 3.0 - t * 0.35, 0.3);
        for (var j = 1; j <= 16; j++) {
            let f = f32(j) / 16.0;
            let yy = 0.3 + f * (top - 0.8);
            let q = around(r * (0.6 + 0.4 * smoothstep(0.0, 0.15, f)), fi / 3.0 + f * 1.25 - t * 0.35, yy);
            let dd = raySeg(ro, rd, prev, q, &s);
            if dd < best {
                best = dd;
                by = (f32(j) - 1.0 + s) / 16.0;
            }
            prev = q;
        }
        let fl = 0.5 + 0.8 * vn(vec2(by * 30.0 - t * 6.0, fi * 5.0));
        col += (vec3<f32>(0.8, 1.0, 1.0) * halo(best, max(0.05, px)) * 1.2 * fl + vec3<f32>(0.2, 0.7, 1.0) * halo(best, 0.2) * 0.55 + vec3<f32>(0.1, 0.45, 0.9) * halo(best, 0.6) * 0.15) * form * fx;
    }
    // spray thrown off the streams
    for (var i = 0; i < 30; i++) {
        let fi = f32(i);
        let f = fract(t * (0.7 + 0.4 * h11(fi * 2.9)) + h11(fi * 5.1));
        let a0 = h11(fi * 1.9) + floor(t * 0.7 + h11(fi * 5.1)) * 0.37;
        let p = around(1.5 + 2.8 * f * (1.0 + 0.5 * st), a0 + 0.12 * f, h11(fi * 3.7 + floor(t * 0.7)) * top + 1.5 * f);
        let dd = rayPt(ro, rd, p, &ta);
        col += vec3<f32>(0.7, 0.95, 1.0) * (halo(dd, max(0.05, px)) * 1.5 + halo(dd, 0.25) * 0.12) * (1.0 - f) * smoothstep(0.0, 0.1, f) * form * fx;
    }
    return col;
}

// ======== the change: the old climate's debris flung out ========
// piece i of the burst: where it is lt seconds after, its trailing end in b0
fn ws_piece(fi: f32, lt: f32, top: f32, k: f32, b0: ptr<function, vec3<f32>>) -> vec3<f32> {
    let a = h11(fi * 3.7 + k);
    let up = (h11(fi * 7.1 + k) - 0.4) * 0.9;
    let dir = normalize(vec3(sin(6.2832 * a), up, cos(6.2832 * a)));
    let v = 7.0 + 7.0 * h11(fi * 1.3 + k);
    let st = around(0.5, a, (0.04 + 0.9 * h11(fi * 1.9 + k)) * top);
    let p = st + dir * v * (1.0 - exp(-lt * 2.4)) / 2.4;
    let ln = select(select(select(select(select(0.8, 0.45, k < 4.5), 1.6, k < 3.5), 1.2, k < 2.5), 0.6, k < 1.5), 0.9, k < 0.5);
    (*b0) = p - dir * ln * (0.4 + 0.6 * exp(-lt * 1.5));
    return p;
}

fn ws_burst(ro: vec3<f32>, rd: vec3<f32>, px: f32, d: f32, top: f32, kp: f32, kn: f32, lt: f32) -> vec3<f32> {
    var s: f32;
    let gp = ws_glow(kp);
    var col: vec3<f32> = vec3<f32>(0.0);
    // the flash
    col += mix(vec3<f32>(1.0), gp, 0.3) * (halo(d, 0.6) * 2.2 + halo(d, 1.8) * 0.45 + halo(d, 4.0) * 0.12) * exp(-lt * 7.0);
    // the blast: a shell of light bursting outward from the whole blade
    let Rb = 3.4 * (1.0 - exp(-lt * 5.0));
    col += mix(vec3<f32>(1.0), gp, 0.5) * halo(abs(d - Rb), 0.3 + 0.25 * Rb) * exp(-lt * 4.5) * smoothstep(0.0, 0.03, lt) * 0.55;
    // the explosion itself: a billowing shell of the old climate's fire, frost, storm, sand,
    // dust or spray rolling out from the whole blade, white-hot inside, fading as it spreads
    let nb = floor(uTime / WS_P);
    // the explosion itself: a billowing shell of the old climate's fire, frost, storm, sand,
    // dust or spray rolling out from the whole blade, white-hot inside, as soft puffs that
    // each face the camera
    if lt < 1.1 {
        let Rx = 0.6 + 5.2 * (1.0 - exp(-lt * 3.2));
        var ta: f32;
        for (var i = 0; i < 28; i++) {
            let fi = f32(i);
            let a = h11(fi * 3.1 + nb);
            let yy = (0.02 + 0.98 * h11(fi * 5.7 + nb)) * top;
            let up = (h11(fi * 7.9 + nb) - 0.5) * Rx * 0.5;
            let c = around(Rx * (0.6 + 0.4 * h11(fi * 1.3 + nb)), a, yy + up);
            let dd = rayPt(ro, rd, c, &ta);
            if dd > 4.0 {
                continue;
            }
            let heat = clamp(1.0 - lt * 1.6, 0.0, 1.0);
            let w = 0.5 + 0.9 * lt + 0.4 * h11(fi * 2.2);
            col += mix(gp * 0.8, vec3<f32>(1.0, 0.95, 0.9), heat * heat) * (halo(dd, w) * 0.55 + halo(dd, w * 2.2) * 0.1) * exp(-lt * 2.6) * smoothstep(0.0, 0.05, lt);
        }
    }
    // shock rings tearing out across the blade, one after another
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        let lr = max(lt - fi * 0.07, 0.0);
        let R = 0.5 + 6.0 * (1.0 - exp(-lr * 2.6));
        let fade = exp(-lr * 2.6) * smoothstep(0.0, 0.03, lr) * (1.0 - smoothstep(0.5, 1.0, lr));
        let y = top * (0.18 + 0.22 * fi + 0.12 * h11(nb * 3.1 + fi));
        // round 13 (Creyon): no rings round the blade; a flash of light where each shock leaves it
        var ta: f32;
        let dr = rayPtRaw(ro, rd, vec3(0.0, y, 0.0), &ta);
        col += (vec3<f32>(1.0) * halo(dr, 0.4 + 0.3 * R * 0.2) * 1.0 + gp * halo(dr, 1.0 + 0.3 * R) * 0.35) * fade;
    }
    // the new climate condensing up the blade from the hilt
    let fr = -1.0 + (top + 3.0) * smoothstep(0.1, 0.7, lt);
    var sf: f32;
    let dsf = raySegRaw(ro, rd, vec3<f32>(0.0, -0.6, 0.0), vec3(0.0, top, 0.0), &sf);
    let yy = -0.6 + sf * (top + 0.6);
    col += mix(vec3<f32>(1.0), ws_glow(kn), 0.5) * halo(dsf, 1.0) * halo(abs(yy - fr), 1.2) * 1.6 * smoothstep(0.08, 0.15, lt) * (1.0 - smoothstep(0.6, 0.8, lt));
    // a flash of the new climate's colour as it condenses
    col += ws_glow(kn) * halo(d, 1.1) * smoothstep(0.1, 0.4, lt) * exp(-max(lt - 0.4, 0.0) * 3.0) * 0.35;
    // debris of the old climate flung out in every direction
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if far > 9.0 {
        return col;
    }
    let life = 1.0 - smoothstep(0.5, 1.6, lt);
    let w = select(select(select(select(select(0.07, 0.08, kp < 4.5), 0.035, kp < 3.5), 0.03, kp < 2.5), 0.06, kp < 1.5), 0.11, kp < 0.5);
    let hot = select(select(select(select(select(vec3<f32>(0.75, 0.95, 1.0), vec3<f32>(1.0, 0.3, 0.2), kp < 4.5), vec3<f32>(1.0, 0.85, 0.55), kp < 3.5), vec3<f32>(0.85, 0.9, 1.0), kp < 2.5), vec3<f32>(0.9, 0.97, 1.0), kp < 1.5), vec3<f32>(1.0, 0.75, 0.35), kp < 0.5);
    for (var i = 0; i < 30; i++) {
        let fi = f32(i);
        var b0: vec3<f32>;
        let b1 = ws_piece(fi, lt, top, kp, &b0);
        let dd = raySeg(ro, rd, b0, b1, &s);
        let tip = 0.4 + 0.6 * s;
        col += (hot * halo(dd, max(w * 1.7 * tip, px)) * 2.0 + gp * halo(dd, 0.5) * 0.55) * life;
    }
    return col;
}

// ======== the big show of each climate, Storm-blade size, all round the blade ========
fn ws_big(ro: vec3<f32>, rd: vec3<f32>, px: f32, k: f32, top: f32, form: f32, st: f32, ch: f32) -> vec3<f32> {
    let t = uTime;
    var s: f32;
    var ta: f32;
    var col: vec3<f32> = vec3<f32>(0.0);
    let boost = form * (1.0 + 0.6 * st + 0.8 * ch);
    if k < 0.5 {
        // Mustafar: tall tongues of fire curling up off the blade
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let rate = 0.7 + 0.4 * h11(fi * 2.3);
            let f = fract(t * rate + h11(fi * 5.1));
            let cy = floor(t * rate + h11(fi * 5.1));
            let y0 = (0.05 + 0.8 * h11(fi * 3.7 + cy)) * top;
            let a0 = h11(fi * 6.3 + cy);
            let H = (3.5 + 3.0 * h11(fi * 1.9 + cy)) * (0.4 + 0.6 * sin(3.1416 * min(f * 1.4, 1.0)));
            var prev = around(0.45, a0, y0);
            var best: f32 = 1.0e3;
            var bu: f32 = 0.0;
            for (var j = 1; j <= 6; j++) {
                let u = f32(j) / 6.0;
                let q = around(0.45 + H * 0.55 * u + 0.4 * sin(u * 4.0 + t * 6.0 + fi), a0 + 0.07 * sin(u * 5.0 - t * 4.0 + fi), y0 + H * u * 1.2);
                let dd = raySeg(ro, rd, prev, q, &s);
                if dd < best {
                    best = dd;
                    bu = (f32(j) - 1.0 + s) / 6.0;
                }
                prev = q;
            }
            let w = mix(0.8, 0.12, bu) * (1.0 - 0.4 * f);
            let life = sin(3.1416 * f);
            col += (ws_fire(1.0 - bu * 0.7) * halo(best, max(w, px)) * 2.6 + vec3<f32>(1.0, 0.3, 0.03) * halo(best, w * 2.5) * 0.6) * life;
        }
        // lava bursts: blobs of molten rock thrown out on arcs, glowing, trailing sparks
        for (var i = 0; i < 14; i++) {
            let fi = f32(i);
            let f = fract(t * 0.55 + h11(fi * 7.7));
            let cy = floor(t * 0.55 + h11(fi * 7.7));
            let y0 = (0.1 + 0.8 * h11(fi * 2.9 + cy)) * top;
            let dir = normalize(vec3(sin(6.2832 * h11(fi * 4.1 + cy)), 0.9 + 0.6 * h11(fi * 1.3 + cy), cos(6.2832 * h11(fi * 4.1 + cy))));
            let v = 6.0 + 4.0 * h11(fi * 5.5 + cy);
            let tt = f * 1.2;
            let p = vec3(0.0, y0, 0.0) + dir * v * tt + vec3(0.0, -6.0 * tt * tt, 0.0);
            let q = vec3(0.0, y0, 0.0) + dir * v * max(tt - 0.08, 0.0) + vec3(0.0, -6.0 * max(tt - 0.08, 0.0) * max(tt - 0.08, 0.0), 0.0);
            let dd = raySeg(ro, rd, q, p, &s);
            let dh = rayPt(ro, rd, p, &ta);
            col += (vec3<f32>(1.0, 0.5, 0.1) * halo(dd, max(0.06, px)) * 1.2 + vec3<f32>(1.0, 0.75, 0.3) * halo(dh, 0.22) * 2.0 + vec3<f32>(1.0, 0.3, 0.02) * halo(dh, 0.8) * 0.4) * (1.0 - f) * smoothstep(0.0, 0.05, f);
        }
    } else if k < 1.5 {
        // Hoth: great ice spikes jutting out of the blade, glinting, and shards whirling round it
        for (var i = 0; i < 14; i++) {
            let fi = f32(i);
            let y0 = (0.05 + 0.88 * h11(fi * 2.7)) * top;
            let a = h11(fi * 6.1) + fi * 0.37;
            let grow = smoothstep(0.0, 0.6, form - 0.04 * fi * 0.0);
            let ln = (2.6 + 2.6 * h11(fi * 1.3)) * grow * (1.0 + 0.3 * st);
            var b0 = around(0.5, a, y0);
            let b1 = around(0.5 + ln, a + 0.02, y0 + ln * 0.55);
            let dd = raySeg(ro, rd, b0, b1, &s);
            let w = max(0.24 * (1.0 - s) + 0.03, px);
            let glint = pow(0.5 + 0.5 * sin(t * 2.0 + fi * 1.7), 16.0);
            col += (vec3<f32>(0.9, 0.97, 1.0) * halo(dd, w) * 1.5 + vec3<f32>(0.4, 0.75, 1.0) * halo(dd, w * 3.5) * 0.4 + vec3<f32>(1.0) * halo(dd, w) * glint * 2.0 * step(0.8, s)) * form;
        }
        for (var i = 0; i < 20; i++) {
            let fi = f32(i);
            let r = 2.0 + 3.0 * h11(fi * 3.9);
            let a = h11(fi * 8.7) + t * (0.25 + 0.2 * h11(fi)) / (0.5 + 0.2 * r);
            let yy = (0.05 + 0.9 * h11(fi * 5.3)) * top + 0.8 * sin(t + fi);
            let c = around(r, a, yy);
            let dv = normalize(vec3(sin(t * 2.0 + fi), cos(t * 1.7 + fi * 2.0), sin(t * 1.3 + fi * 3.0))) * 0.35;
            let dd = raySeg(ro, rd, c - dv, c + dv, &s);
            col += (vec3<f32>(0.9, 0.97, 1.0) * halo(dd, max(0.05, px)) * 1.6 + vec3<f32>(0.5, 0.8, 1.0) * halo(dd, 0.3) * 0.3) * boost;
        }
        // frost bursts: rings of frost blasting out along the blade
        for (var i = 0; i < 2; i++) {
            let fi = f32(i);
            let f = fract(t * 0.6 + fi * 0.5);
            let yr = (0.25 + 0.5 * h11(floor(t * 0.6 + fi * 0.5) + fi * 3.0)) * top;
            // round 13: frost spraying off the blade instead of rings round it
            let fx_ = fxSparks(ro, rd, px, yr - 1.0, yr + 1.0, 8.0, 2.0 + 3.0 * f, 1.5, fi * 3.3, vec3<f32>(0.6, 0.85, 1.0));
            col += fx_ * (1.0 - f) * form * 0.8;
        }
    } else if k < 2.5 {
        // Kamino: big Storm-blade lightning loops leaping off the blade, struck again and again
        for (var i = 0; i < 5; i++) {
            let fi = f32(i);
            let kk = floor(t * (7.0 + 3.0 * st) + fi * 0.31);
            if h11(kk * 1.7 + fi) < 0.25 {
                continue;
            }
            let y0 = (0.05 + 0.75 * h11(kk * 2.3 + fi * 3.1)) * top;
            let dy = 3.0 + 6.0 * h11(kk * 3.9 + fi);
            let a = h11(kk * 5.1 + fi);
            let reach = (3.8 + 2.2 * h11(kk * 0.7 + fi)) * (1.0 + 0.2 * st);
            let A = around(0.35, a, y0);
            let M = around(reach, a + 0.05 * (h11(kk) - 0.5), y0 + dy * 0.5);
            let C = around(0.35, a + 0.1, y0 + dy);
            let bd = min(bolt3(ro, rd, A, M, kk + fi * 11.0, 0.35), bolt3(ro, rd, M, C, kk + fi * 11.0 + 0.5, 0.35));
            let fade = exp(-fract(t * (7.0 + 3.0 * st) + fi * 0.31) * 2.5);
            col += (boltLight(bd, vec3<f32>(0.45, 0.65, 1.0), px) * 2.2 + vec3<f32>(0.4, 0.6, 1.0) * halo(bd, 1.5) * 0.4) * fade * form;
        }
        // bolts leaping from the tip into the sky
        for (var i = 0; i < 2; i++) {
            let fi = f32(i);
            let kk = floor(t * 5.0 + fi * 0.5);
            if h11(kk * 3.3 + fi) < 0.45 {
                continue;
            }
            let A = vec3(0.0, top, 0.0);
            let C = A + around(2.0 + 2.0 * h11(kk + fi), h11(kk * 2.1 + fi), 3.5 + 2.0 * h11(kk * 4.4));
            let bd = bolt3(ro, rd, A, C, kk + fi * 7.0, 0.4);
            col += boltLight(bd, vec3<f32>(0.5, 0.7, 1.0), px) * 1.4 * exp(-fract(t * 5.0 + fi * 0.5) * 3.0) * form;
        }
        // sea spray flung off the blade
        for (var i = 0; i < 16; i++) {
            let fi = f32(i);
            let f = fract(t * 0.8 + h11(fi * 3.1));
            let y0 = (0.05 + 0.9 * h11(fi * 6.3 + floor(t * 0.8 + h11(fi * 3.1)))) * top;
            let p = around(0.5 + 4.0 * f, h11(fi * 9.1) + 0.1 * f, y0 + 1.5 * f - 2.5 * f * f);
            let dd = rayPt(ro, rd, p, &ta);
            col += vec3<f32>(0.7, 0.85, 1.0) * (halo(dd, max(0.05, px)) * 1.2 + halo(dd, 0.25) * 0.2) * (1.0 - f) * form;
        }
    } else if k > 3.5 && k < 4.5 {
        // Crait: red energy cracking out from the blade to the floating boulders
        for (var i = 0; i < 9; i++) {
            let fi = f32(i);
            var b0: vec3<f32>;
            let b1 = ws_shard(fi, form, &b0);
            if b1.y > top {
                continue;
            }
            let kk = floor(t * 4.0 + fi * 0.37);
            if h11(kk * 1.9 + fi) < 0.55 {
                continue;
            }
            let c = (b0 + b1) * 0.5;
            let A = around(0.45, atan2(c.x, c.z) / 6.2832, c.y);
            let bd = bolt3(ro, rd, A, c, kk + fi * 5.0, 0.35);
            col += (boltLight(bd, vec3<f32>(1.0, 0.12, 0.08), px) * 1.2) * exp(-fract(t * 4.0 + fi * 0.37) * 3.0) * form;
        }
        // red salt dust streaming off the boulders and blade
        for (var i = 0; i < 18; i++) {
            let fi = f32(i);
            let f = fract(t * 0.5 + h11(fi * 2.3));
            let y0 = (0.05 + 0.9 * h11(fi * 7.1 + floor(t * 0.5 + h11(fi * 2.3)))) * top;
            let p = around(0.6 + 4.2 * f, h11(fi * 4.9) + 0.25 * f, y0 + 1.0 * f);
            let q = around(0.6 + 4.2 * max(f - 0.06, 0.0), h11(fi * 4.9) + 0.25 * max(f - 0.06, 0.0), y0 + 1.0 * max(f - 0.06, 0.0));
            let dd = raySeg(ro, rd, q, p, &s);
            col += vec3<f32>(1.0, 0.2, 0.12) * (halo(dd, max(0.06, px)) * 1.1 + halo(dd, 0.35) * 0.2) * sin(3.1416 * f) * form;
        }
    }
    return col;
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let top = ws_top();
    let lt = ws_lt();
    let k = ws_cur();
    let kp = ws_prev();
    let form = ws_form();
    let ch = ws_charge();
    let boom = ws_boom();
    let st = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let fx = uFx;
    var s: f32;
    let d = raySegRaw(ro, rd, vec3<f32>(0.0, -0.6, 0.0), vec3(0.0, top, 0.0), &s);
    var col: vec3<f32> = vec3<f32>(0.0);
    if k < 0.5 {
        col = ws_lava(ro, rd, px, d, top, form, ch, st, fx);
    } else if k < 1.5 {
        col = ws_ice(ro, rd, px, d, top, form, ch, st, fx);
    } else if k < 2.5 {
        col = ws_storm(ro, rd, px, d, top, form, ch, st, fx);
    } else if k < 3.5 {
        col = ws_sand(ro, rd, px, d, top, form, ch, st, fx);
    } else if k < 4.5 {
        col = ws_rock(ro, rd, px, d, top, form, ch, st, fx);
    } else {
        col = ws_water(ro, rd, px, d, top, form, ch, st, fx);
    }
    col += ws_big(ro, rd, px, k, top, form, st, ch) * fx;
    // the straining climate trembles with light just before it bursts
    col += mix(vec3<f32>(1.0), ws_glow(k), 0.5) * halo(d, 0.9) * ch * ch * (0.6 + 0.4 * sin(uTime * 40.0)) * 0.8;
    if boom > 0.5 && lt < 1.6 {
        col += ws_burst(ro, rd, px, d, top, kp, k, lt) * fx;
    }
    // clash: the ruling climate flashes
    if cl > 0.01 {
        var ta: f32;
        let dc = rayPtRaw(ro, rd, vec3(0.0, min(uLength * 0.6, top), 0.0), &ta);
        col += (vec3<f32>(1.0) * halo(dc, 1.0) * 2.5 + ws_glow(k) * halo(dc, 2.8) * 1.2) * cl * cl;
        col += ws_glow(k) * halo(ws_ring(ro, rd, min(uLength * 0.6, top), 0.5 + 5.0 * (1.0 - cl)), 0.25) * cl * 1.2;
    }
    return (1.0 - exp(-col * 1.1)) * 1.05;
}

// ======== the solid parts: crusts (Mustafar basalt, Crait salt), chunks and shards ========
fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let top = ws_top();
    let lt = ws_lt();
    let k = ws_cur();
    let kp = ws_prev();
    let form = ws_form();
    let ch = ws_charge();
    let boom = ws_boom();
    var s: f32;
    var ta: f32;
    let tc: f32 = 1.0e5;
    var o: vec4<f32> = vec4<f32>(0.0);
    let oldCrust = select((select(0.0, 1.0, kp > 3.5 && kp < 4.5)), 1.0, kp < 0.5);
    if uFx <= 0.0 {
        return o;
    }
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if far > 9.0 {
        return o;
    }
    // chunks of the old crust flung out (basalt or salt)
    if boom > 0.5 && oldCrust > 0.5 && lt < 1.6 {
        let life = 1.0 - smoothstep(0.7, 1.6, lt);
        for (var i = 0; i < 14; i++) {
            let fi = f32(i);
            var b0: vec3<f32>;
            let b1 = ws_piece(fi, lt, top, kp, &b0);
            let dd = raySeg(ro, rd, b0, b1, &s);
            let w = (0.09 + 0.06 * h11(fi * 2.3)) * (0.25 + 0.75 * sqrt(sin(3.1416 * s)));
            let al = fillD(dd - w, px) * life;
            if al <= 0.0 {
                continue;
            }
            let tmid = rayPt(ro, rd, (b0 + b1) * 0.5, &ta);
            let rim = smoothstep(w * 0.3, w, dd);
            let c = select(vec3<f32>(0.88, 0.86, 0.84) * (0.95 - 0.35 * rim) + vec3<f32>(1.0, 0.12, 0.1) * rim * 0.5, vec3<f32>(0.08, 0.05, 0.04) * (1.0 - 0.5 * rim) + vec3<f32>(1.0, 0.35, 0.05) * rim * 0.8, kp < 0.5);
            o = vec4(mix(o.rgb, c, al), max(o.a, al));
        }
    }
    // Crait: salt shards drifting round the blade
    if k > 3.5 && k < 4.5 {
        for (var i = 0; i < 9; i++) {
            let fi = f32(i);
            var b0: vec3<f32>;
            let b1 = ws_shard(fi, form, &b0);
            if b1.y > top {
                continue;
            }
            let dd = raySeg(ro, rd, b0, b1, &s);
            let w = (0.32 + 0.22 * h11(fi * 4.1)) * (0.2 + 0.8 * sqrt(sin(3.1416 * s)));
            let al = fillD(dd - w, px) * form;
            if al <= 0.0 {
                continue;
            }
            let tmid = rayPt(ro, rd, (b0 + b1) * 0.5, &ta);
            let rim = smoothstep(w * 0.2, w, dd);
            let c = vec3<f32>(0.9, 0.88, 0.86) * (1.0 - 0.45 * rim) + vec3<f32>(1.0, 0.12, 0.1) * rim * 0.45;
            o = vec4(mix(o.rgb, c, al), max(o.a, al));
        }
    }
    return o;
}

// the blade: Sol's glow and core from the file, taking the ruling climate's colour (and
// the next one's as it condenses up the blade after a change)
fn ws_tint(g: vec3<f32>, b: vec2<f32>) -> vec3<f32> {
    let k = ws_cur();
    let lt = ws_lt();
    let l = max(g.r, max(g.g, g.b));
    let cn = ws_glow(k);
    let fr = select(1.0e5, -1.0 + (uLength + 3.0) * smoothstep(0.1, 0.7, lt), ws_boom() > 0.5);
    let c = select(ws_glow(ws_prev()), cn, b.y < fr);
    return l * c / max(max(c.r, max(c.g, c.b)), 0.01);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let ch = ws_charge();
    return ws_tint(g, b) * (1.0 + ch * ch * (0.6 + 0.4 * sin(uTime * 40.0)) + 0.3 * uSwing);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    let t = ws_tint(c, b);
    return mix(c, t, 0.35);
}

// the solid sheaths, drawn over Sol's glow as his solid blades are: Mustafar's cracked
// basalt crust, Hoth's ice crystal, Crait's white salt crust over the red
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let k = ws_cur();
    let top = ws_top();
    let form = ws_form();
    let ch = ws_charge();
    let yc = -0.3 + (top + 0.3) * form;
    if k > 0.5 && k < 1.5 {
        // ice: a pale faceted sheath, see-through, its edges bright, frost on it
        let A: f32 = 0.62;
        let cov = fillD(abs(b.x) - A, px) * smoothstep(0.1, 0.8, b.y) * (1.0 - smoothstep(yc - 2.5, yc, b.y));
        if cov <= 0.0 {
            return o;
        }
        let u = b.x / A;
        let frost = vn(vec2(u * 9.0, b.y * 4.0)) * vn(vec2(u * 3.0 + 5.0, b.y * 1.3));
        let edge = halo(1.0 - abs(u), 0.06) + halo(abs(u) - 0.5, 0.03 + px) * 0.6;
        var c = vec3<f32>(0.5, 0.8, 1.0) * (0.15 + 0.5 * frost) + vec3<f32>(0.9, 0.97, 1.0) * edge * 0.9;
        c += vec3<f32>(1.0) * halo(abs(vn(vec2(u * 2.0 + 9.0, b.y * 0.6)) - 0.5), 0.02) * ch * 1.5;
        let al = cov * (0.35 + 0.4 * frost + 0.3 * edge);
        return vec4(mix(o.rgb, c, al), max(o.a, al));
    }
    if k < 0.5 || (k > 3.5 && k < 4.5) {
        let Rc: f32 = 0.6;
        let y1 = min(top - 0.9, form * (top + 1.0));
        let cov = fillD(abs(b.x) - Rc, px) * smoothstep(0.1, 0.7, b.y) * (1.0 - smoothstep(y1 - 0.4, y1 + 0.6, b.y));
        if cov <= 0.0 {
            return o;
        }
        let u = clamp(b.x / Rc, -1.0, 1.0);
        var cell: vec2<f32>;
        let e = select(voro(vec2(u * 2.5, b.y * 1.2), &cell), voro(vec2(u * 2.5, b.y * 1.0 + uTime * 0.22), &cell), k < 0.5);
        let w = (select(0.04 + 0.03 * sin(uTime * 1.5 + cell.x * 2.0 + cell.y * 1.3), 0.13 + 0.05 * sin(uTime * 2.0 + cell.x * 3.0 + cell.y), k < 0.5)) + ch * 0.12;
        let al = cov * smoothstep(w, w + 0.06, e);
        let dif = clamp(0.55 - 0.45 * u + 0.2 * sqrt(1.0 - u * u), 0.0, 1.0);
        let nz = vn(vec2(u * 12.0, b.y * 6.0));
        let glow_ = exp(-max(e - w, 0.0) / (select(0.09, 0.07, k < 0.5)));
        var c: vec3<f32>;
        if k < 0.5 {
            c = vec3<f32>(0.09, 0.055, 0.04) * (0.6 + 0.7 * nz) * (0.45 + 0.55 * dif) + vec3<f32>(1.0, 0.32, 0.04) * glow_ * 1.2;
        } else {
            c = vec3<f32>(1.0, 0.98, 0.96) * (0.75 + 0.25 * nz) * (0.55 + 0.6 * dif) + vec3<f32>(1.0, 0.1, 0.08) * glow_;
        }
        return vec4(mix(o.rgb, c, al), max(o.a, al));
    }
    return o;
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    fx += fxSparks(ro, rd, px, y0, y1, 12.0, 6.0, 0.8, 6.4, vec3<f32>(0.95, 0.75, 0.6)) * part(1.0);
    return col + fx * uFx;
}

// Obsidian Edge: Creyon's Blade Lab design, reworked in full. A flat blade of black volcanic glass,
// as thin as a stock blade, with glassy facets catching the light, white-hot edges crackling along
// both sides and lava veins pulsing up through the glass. Round it, in 3D, a ring of obsidian
// shards orbits slowly, black glass with glowing magma edges, magma lightning leaps between the
// blade and the shards, white-hot beams flash off the edge and the air shimmers with heat. A
// swing spins the shards out wider; a clash shatters a burst of shards off the blade with a white
// flash and a shock ring; ignition: the glass is forged hot from the hilt.
fn ob_w(y: f32) -> f32 {
    // half width of the flat glass along the blade
    let L = uLength;
    return 0.56 * (1.0 - smoothstep(L - 2.2, L + 0.05, y)) + 0.05;
}

// the edge's crackle: bright flickering segments
fn ob_crack(y: f32, t: f32) -> f32 {
    let n = vn(vec2(y * 1.7, t * 7.0)) * 0.6 + vn(vec2(y * 5.0, t * 13.0)) * 0.4;
    return 0.55 + 0.9 * smoothstep(0.45, 0.85, n);
}

// lava veins: thin branching cracks drifting up through the glass
fn ob_vein(b: vec2<f32>, t: f32) -> f32 {
    let q = vec2(b.x * 3.2, b.y * 0.55 - t * 0.9);
    let n = vn(q * 1.7);
    let line = abs(n - 0.5);
    return smoothstep(0.06, 0.0, line) * smoothstep(0.35, 0.7, vn(vec2(b.y * 0.25 - t * 0.6, 3.0)));
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px_in: f32) -> vec3<f32> {
    var px = px_in;
    let L = uLength;
    px = min(px, 0.06);
    let on = smoothstep(-0.6, 0.3, b.y);
    let edge = 1.0 - smoothstep(6.5, 8.5, abs(b.x));
    let forge = 1.0 - smoothstep(0.0, 1.8, uAge);
    // ignition heat
    let w = ob_w(b.y);
    let ax = abs(b.x);
    // round 23 (Creyon's game, 22/10/2026: an orange box ended at a straight line level with the
    // tip): the edges' blooms fade out round the tip and into the hilt instead of stopping at once
    let inside = (1.0 - smoothstep(L - 0.6, L + 1.6, b.y)) * smoothstep(-0.8, -0.1, b.y);
    // white-hot edges: thin bright lines on both sides, crackling, with a hot orange bloom
    let de = abs(ax - w);
    let cr = ob_crack(b.y + sign(b.x) * 7.0, uTime);
    var light = vec3<f32>(1.0, 0.97, 0.92) * exp(-pow(de / 0.07, 2.0)) * 1.6 * cr * inside;
    light += vec3<f32>(1.0, 0.5, 0.15) * halo(de, 0.35) * 0.5 * cr * inside + vec3<f32>(1.0, 0.35, 0.08) * halo(de, 1.4) * 0.12 * inside;
    // the tip: the two edges meet in a hot point
    let dt = length(vec2(b.x, max(b.y - L, 0.0)));
    light += vec3<f32>(1.0, 0.8, 0.5) * halo(dt, 0.25) * 0.5 * smoothstep(L - 1.2, L - 0.3, b.y);
    // sparks running along the edge
    for (var k = 0; k < 5; k++) {
        let fk = f32(k);
        let y = glsl_mod(uTime * (9.0 + 3.0 * fk) + h11(fk * 4.0) * L, L + 4.0) - 2.0;
        let s = select(-1.0, 1.0, glsl_mod(fk, 2.0) < 0.5);
        light += vec3<f32>(1.0, 0.9, 0.7) * halo(length(vec2(b.x - s * ob_w(y), b.y - y)), 0.12) * 1.5;
    }
    // clash: a burst of big shards blown off the strike point with a white flash
    if uClash > 0.01 {
        let a = 1.0 - uClash;
        let o = vec2(0.0, L * 0.55);
        light += vec3<f32>(1.0, 0.95, 0.85) * halo(length(b - o), 1.2) * pow(uClash, 4.0) * 1.5;
        for (var k = 0; k < 10; k++) {
            let fk = f32(k);
            let an = fk * 0.628 + 0.4 * h11(fk * 2.0);
            let dir = vec2(cos(an), sin(an));
            let p = o + dir * (0.5 + 7.0 * (1.0 - exp(-3.0 * a)));
            var q = b - p;
            let rr = uTime * 6.0 + fk;
            q = vec2(q.x * cos(rr) - q.y * sin(rr), q.x * sin(rr) + q.y * cos(rr));
            let sh = max(abs(q.x) - 0.12, abs(q.y) - 0.38 + abs(q.x) * 1.6);
            let heat = uClash;
            light += mix(vec3<f32>(0.6, 0.1, 0.03), vec3<f32>(1.0, 0.85, 0.6), heat) * (fillD(sh, px) + halo(max(sh, 0.0), 0.25) * 0.5);
        }
    }
    light *= on * edge * (1.0 - smoothstep(L + 1.5, L + 5.0, b.y)) * smoothstep(-3.0, -0.5, b.y);
    return (1.0 - exp(-light * 1.15)) * 1.05 * clamp(uIgn * 1.5, 0.0, 1.0);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(0.0);
}

// the glass itself: black, faceted, with moving glints and the lava veins inside
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px_in: f32) -> vec4<f32> {
    var px = px_in;
    px = min(px, 0.06);
    let L = uLength;
    let w = ob_w(b.y);
    let cov = fillD(abs(b.x) - w, px) * step(-0.3, b.y) * fillD(b.y - L - 0.05, px);
    if cov <= 0.0 {
        return o;
    }
    let forge = 1.0 - smoothstep(0.0, 1.8, uAge);
    // facets: conchoidal ripples in the glass, a ridge down the middle
    let ridge = 1.0 - abs(b.x) / max(w, 0.01);
    let conch = vn(vec2(b.x * 4.0, b.y * 0.9)) * 0.6 + vn(vec2(b.x * 9.0, b.y * 2.3)) * 0.4;
    let rings = 0.5 + 0.5 * sin(conch * 14.0);
    // a glint sweeping up the blade, and a cool sky sheen on one face
    let gl = exp(-pow((b.y - glsl_mod(uTime * 11.0, L + 16.0) + 8.0 + b.x * 3.0) / 1.2, 2.0));
    var glass = vec3<f32>(0.025, 0.022, 0.03) + vec3<f32>(0.06, 0.07, 0.1) * rings * 0.6 + vec3<f32>(0.12, 0.13, 0.17) * smoothstep(0.7, 1.0, ridge) * 0.6;
    glass += vec3<f32>(0.75, 0.8, 0.95) * gl * (0.25 + 0.5 * rings) * smoothstep(0.1, 0.9, ridge);
    // lava veins glowing inside, brighter while forging and on swing
    let vein = ob_vein(b, uTime);
    let lava = mix(vec3<f32>(0.9, 0.2, 0.03), vec3<f32>(1.0, 0.75, 0.3), vein);
    glass = mix(glass, lava * (1.2 + 0.8 * uSwing), vein * (0.7 + 0.3 * sin(uTime * 3.0 + b.y * 0.4)));
    glass = mix(glass, vec3<f32>(1.0, 0.45, 0.1), forge * 0.85);
    return vec4(mix(o.rgb, glass, cov), max(o.a, cov * 0.98 * clamp(uIgn * 1.5, 0.0, 1.0)));
}

// ---- round 9 (Creyon): no flying chips; obsidian shards orbiting in 3D, magma arcs, beams ----
// a shard of black glass at c: how much of the ray it covers, where (th) and its shading
// (sh.x facet light, sh.y the glowing edge)
fn ob_shard(ro: vec3<f32>, rd: vec3<f32>, c: vec3<f32>, sz: f32, spin: f32, seed: f32, px: f32, th: ptr<function, f32>, sh: ptr<function, vec2<f32>>) -> f32 {
    let d = rayPt(ro, rd, c, th);
    (*sh) = vec2<f32>(0.0);
    if d > sz * 2.0 + px {
        return 0.0;
    }
    var o = ro + rd * (*th) - c;
    let a = rot(spin + seed * 6.0) * o.xy;
    o = vec3(a, o.z);
    let b = rot(spin * 0.7 + seed * 3.0) * o.yz;
    o = vec3(o.x, b);
    // a long sharp sliver of glass, pointed at both ends
    let k = max(abs(o.x) * 1.8 + abs(o.y) * 0.45, abs(o.z) * 3.0) - sz * 0.7;
    (*sh) = vec2(0.5 + 0.5 * h21(sign(o.xy) + vec2(seed * 7.0, sign(o.z))), halo(abs(k), 0.04 + px * 0.8));
    return clamp(0.5 - k / max(px, 1.0e-3), 0.0, 1.0);
}

// shard i's place round the blade
fn ob_place(fi: f32) -> vec3<f32> {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let a = h11(fi * 1.7) + uTime * (0.05 + 0.04 * h11(fi * 2.9));
    let R = 2.4 + 2.2 * h11(fi * 5.1) + 2.0 * sw;
    let y = (0.18 + 0.78 * fract(fi * 0.381 + 0.07)) * L + 0.8 * sin(uTime * 0.6 + fi * 2.0);
    return around(R, a, y);
}

// round 10: the shards circle the blade, so they are drawn in true 3D (only orbits are)
fn base_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var col: vec4<f32> = vec4<f32>(0.0);
    if uFx < 0.01 || fxNear(ro, rd, uLength * 0.1, uLength) > 8.0 {
        return col;
    }
    var bestT: f32 = 1.0e5;
    for (var i = 0; i < 18; i++) {
        let fi = f32(i);
        var th: f32;
        var sh: vec2<f32>;
        let cv = ob_shard(ro, rd, ob_place(fi), 1.2 + 0.7 * h11(fi * 9.1), uTime * (0.4 + 0.5 * h11(fi)) + fi, fi, px, &th, &sh);
        if cv > 0.0 && th < bestT {
            bestT = th;
            let pulse = 0.6 + 0.4 * sin(uTime * 2.0 + fi * 1.3);
            let rgb = vec3<f32>(0.03, 0.028, 0.035) + vec3<f32>(0.25, 0.27, 0.33) * pow(sh.x, 3.0) * 0.6 + vec3<f32>(1.0, 0.45, 0.1) * sh.y * 1.6 * pulse;
            col = vec4(rgb, cv);
        }
    }
    return col;
}

fn base_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    let hot: vec3<f32> = vec3<f32>(1.0, 0.45, 0.1);
    let white: vec3<f32> = vec3<f32>(1.0, 0.92, 0.8);
    var col: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > 10.0 {
        return col;
    }
    // white-hot beams flashing off the edges
    col += fxAura(ro, rd, y0, y1, 2.8, hot) * 0.8;
    // a clash: a shock ring and a flash
    return col * uFx;
}

// the shards' glow and the magma lightning leaping from the blade to them, in true 3D with them
fn base_orbit(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let hot: vec3<f32> = vec3<f32>(1.0, 0.45, 0.1);
    var col: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, L * 0.1, L) > 10.0 {
        return col;
    }
    var ta: f32;
    // the shards' glow, and magma lightning leaping from the blade to them
    for (var i = 0; i < 18; i++) {
        let fi = f32(i);
        let p = ob_place(fi);
        col += hot * halo(rayPt(ro, rd, p, &ta), 1.0) * 0.12;
        let k = floor(t * 1.3 + h11(fi * 3.3) * 7.0);
        let q = fract(t * 1.3 + h11(fi * 3.3) * 7.0);
        if h11(k * 2.7 + fi) > 0.35 + 0.4 * sw {
            continue;
        }
        let d = bolt3(ro, rd, vec3(0.0, p.y + (h11(k + fi) - 0.5) * 3.0, 0.0), p, k + fi * 1.7, 0.45);
        col += boltLight(d, hot, px) * (1.0 - q) * (1.0 - q);
    }
    return col * uFx;
}

// round 11: sig_vol gated by part 0
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(0.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    return base_vol(ro, rd, px);
}

// round 11: sig_orbit gated by part 1
fn sig_orbit(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(1.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    return base_orbit(ro, rd, px);
}

// round 11: sig_orbit_solid gated by part 1
fn sig_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    if part(1.0) < 0.5 {
        return vec4<f32>(0.0);
    }
    return base_orbit_solid(ro, rd, px);
}

// Event Horizon: the blade is a black hole stretched into a line. Its heart is a rod of pure
// darkness outlined by a razor-thin photon ring, with light running down its edges as it is
// pulled in. Two real accretion disks of hot swirling matter circle the blade at two heights,
// turning, brighter on the side rushing toward you, each wrapped in a thin lensed photon ring;
// streams of matter spiral in along the blade from the disks in pulses of light. Seen from above
// the disks are full whirlpools inside a bright Einstein ring; from the side, thin blazing lines.
// A swing spins the disks up and speeds the infalling streams; a clash fires a gravity wave.
fn eh_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn eh_h(k: f32) -> f32 {
    return uLength * (0.36 + 0.34 * k) + 0.9 * sin(uTime * (0.4 - 0.07 * k) + k * 2.0);
}

// how far a disk has grown (it spreads out from the blade as the ignition passes its height)
fn eh_grow(h: f32) -> f32 {
    return smoothstep(h - 1.0, h + 5.0, eh_top());
}

// one accretion disk at height h: clumps of hot matter orbiting the blade on many rings,
// brighter on the side rushing toward you, a thin blazing ring at its inner edge; each clump
// a piece facing the camera, as Sol's Void blade orbits its black holes
fn eh_disk(ro: vec3<f32>, rd: vec3<f32>, h: f32, k: f32, tmax: f32, g: f32, px: f32) -> vec3<f32> {
    let vio: vec3<f32> = vec3<f32>(0.62, 0.36, 1.0);
    let white: vec3<f32> = vec3<f32>(1.0, 0.96, 1.0);
    var acc: vec3<f32> = vec3<f32>(0.0);
    var tq: f32;
    if g < 0.01 || rayPtRaw(ro, rd, vec3(0.0, h, 0.0), &tq) > 7.5 * g {
        return acc;
    }
    let sw = clamp(uSwing, 0.0, 1.0);
    let boost = 1.0 + 0.6 * sw + 1.2 * clamp(uClash, 0.0, 1.0);
    for (var i = 0; i < 40; i++) {
        let fi = f32(i);
        let r = (0.95 + 4.6 * pow(h11(fi * 3.1 + k * 7.0), 1.6)) * g;
        let a = h11(fi * 5.7 + k) + uTime * 0.55 / (0.4 + 0.35 * r);
        let p = around(r, a, h + 0.08 * (h11(fi * 2.2) - 0.5) * r);
        // each clump a short streak along its orbit
        let q = around(r, a - 0.05 / (0.5 + 0.3 * r), p.y);
        var s: f32;
        let d = raySeg(ro, rd, q, p, &s);
        let T = clamp(1.25 * g / r, 0.0, 1.0);
        let vt = normalize(vec3(cos(6.2832 * a), 0.0, -sin(6.2832 * a)));
        let dop = dot(vt, -rd);
        let beam = pow(1.0 + 0.6 * dop, 3.0);
        let c = mix(vio, white, T * T * (0.6 + 0.4 * clamp(dop, 0.0, 1.0)));
        acc += c * (halo(d, max(0.06 + 0.04 * r, px)) * 1.1 + halo(d, 0.35 + 0.1 * r) * 0.25) * beam * (0.5 + 1.5 * T) * boost * step(dot(p - ro, rd), tmax);
    }
    // the innermost stable orbit: a thin ring blazing round the hole
    let hp = rayAt(ro, rd, h);
    if hp.z > 0.0 && hp.z < tmax {
        let rr = hideD(abs(length(hp.xy) - 0.85 * g), behindBlade(ro, rd, hp.z));
        acc += white * (halo(rr, max(0.04, px)) * 1.3 + vio * halo(rr, 0.3) * 0.4) * boost;
    }
    return acc;
}

// all the effects round the blade, counted only up to tmax along the ray
fn eh_fx(ro: vec3<f32>, rd: vec3<f32>, px: f32, tmax: f32) -> vec3<f32> {
    let L = uLength;
    let top = eh_top();
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let vio: vec3<f32> = vec3<f32>(0.62, 0.36, 1.0);
    let white: vec3<f32> = vec3<f32>(1.0, 0.96, 1.0);
    var light: vec3<f32> = vec3<f32>(0.0);
    var s: f32;
    var tq: f32;
    for (var k = 0; k < 2; k++) {
        let fk = f32(k);
        let h = eh_h(fk);
        let g = eh_grow(h);
        if g < 0.01 {
            continue;
        }
        light += eh_disk(ro, rd, h, fk, tmax, g, px);
        // the lensed photon ring: a thin ring of bent light hugging the hole at the disk's height,
        // always facing you; brighter when seen from above
        let dc = rayPtRaw(ro, rd, vec3(0.0, h, 0.0), &tq);
        if tq < tmax {
            let q = ro + rd * tq - vec3(0.0, h, 0.0);
            let side = dot(normalize(vec3(-q.z, 0.0, q.x) + 1.0e-4), -rd);
            let flick = 0.75 + 0.25 * sin(atan2(q.y, length(q.xz) * sign(q.x + 1.0e-4)) * 5.0 - uTime * 6.0);
            let rr = abs(dc - 0.95 * g);
            let up = 0.55 + 0.9 * rd.y * rd.y;
            light += (white * halo(rr, max(0.035, px)) * 1.8 + vio * halo(rr, 0.25) * 0.35) * (0.7 + 0.5 * side) * flick * up * g;
        }
        // matter streams spiralling in along the blade from the disk's inner edge, up and down
        let da = raySegRaw(ro, rd, vec3(0.0, h - 7.5, 0.0), vec3(0.0, h + 7.5, 0.0), &s);
        if da > 2.6 {
            continue;
        }
        for (var j = 0; j < 4; j++) {
            let fj = f32(j);
            let dir = select(-1.0, 1.0, j < 2);
            let a0 = fj * 0.5 + fk * 0.3 - uTime * 0.35;
            var prev = around(1.7 * g, a0, h);
            for (var i = 1; i <= 8; i++) {
                let u = f32(i) / 8.0;
                let p = around(mix(1.7, 0.36, sqrt(u)) * g, a0 + u * 1.6 * dir, h + dir * u * 7.0 * g);
                let d = raySeg(ro, rd, prev, p, &s);
                if d < 0.6 {
                    let uu = u - (1.0 - s) / 8.0;
                    let qp = mix(prev, p, s);
                    let tt = dot(qp - ro, rd);
                    let pulse = 0.35 + 0.65 * pow(0.5 + 0.5 * sin(uu * 14.0 - uTime * 7.0 + fj * 1.3), 3.0);
                    let fade = (1.0 - smoothstep(0.6, 1.0, uu)) * smoothstep(0.0, 0.08, uu);
                    let c = mix(vio, white, uu * 0.7 + 0.2);
                    light += c * (halo(d, max(0.035, px)) * 1.3 + halo(d, 0.18) * 0.35) * pulse * fade * step(tt, tmax);
                }
                prev = p;
            }
        }
    }
    // the Einstein ring: from above (or below) a bright ring of lensed light circles the blade
    let aligned = smoothstep(0.8, 0.97, -rd.y);
    if aligned > 0.0 {
        let hE = eh_h(1.0);
        let dA = rayPtRaw(ro, rd, vec3(0.0, hE, 0.0), &tq);
        let er = abs(dA - 3.1 - 0.15 * sin(uTime * 1.3));
        let pa = ro + rd * tq;
        let ang = atan2(pa.z, pa.x);
        let sh = 0.6 + 0.4 * sin(ang * 3.0 + uTime * 2.0);
        light += (white * halo(er, max(0.05, px)) * 2.2 + vio * halo(er, 0.5) * 0.45) * sh * aligned * eh_grow(hE);
    }
    // a clash: a gravity wave (a sphere of bent light) bursts out from the struck point
    if cl > 0.01 {
        let dc = rayPtRaw(ro, rd, vec3(0.0, L * 0.6, 0.0), &tq);
        let rr = abs(dc - 0.6 - 5.5 * (1.0 - cl));
        light += (white * halo(rr, 0.1) * 2.2 + vio * halo(rr, 0.8) * 0.5) * cl * step(tq, tmax);
    }
    return light;
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    // The blade is Sol's glow and core from the file round the black rod (sig_glow,
    // sig_solid); here only the effects, each a piece placed round it in 3D.
    return eh_fx(ro, rd, px, 1.0e9) * uFx;
}

// the black rod, drawn over Sol's glow as his solid blades are: pure darkness from just
// above the emitter to the tip
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = eh_top();
    if top < 1.3 {
        return o;
    }
    let a = fillD(abs(b.x) - 0.28, px) * smoothstep(1.0, 1.6, b.y) * (1.0 - smoothstep(top - 0.6, top - 0.2, b.y));
    return vec4(mix(o.rgb, vec3<f32>(0.01, 0.0, 0.02), a * 0.96), max(o.a, a * 0.96));
}

// the blade: Sol's glow from the file, light streaming down its edges as it falls in, a razor
// photon ring at the rod's rim
fn sig_glow_own(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let stream = 0.65 + 0.35 * sin(b.y * 0.9 + uTime * 12.0) + 0.3 * pow(0.5 + 0.5 * sin(b.y * 0.23 + uTime * 5.0), 6.0);
    let rim = exp(-pow((abs(b.x) - 0.33) / max(0.06, px), 2.0)) * smoothstep(1.0, 1.6, b.y) * (1.0 - smoothstep(eh_top() - 0.6, eh_top() - 0.2, b.y));
    return g + vec3<f32>(1.0, 0.96, 1.0) * rim * (1.2 * stream + 1.5 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let vio: vec3<f32> = vec3<f32>(0.6, 0.3, 1.0);
    fx += fxCoils(ro, rd, px, L * 0.04, y1, 2.6, 1.6, -0.6, 3.0, vio) * part(1.0);
    for (var i = 0; i < 3; i++) {
        let q = fract(t * 0.4 + f32(i) / 3.0);
        fx += fxShock(ro, rd, px, mix(L * 0.3, L * 0.8, f32(i) * 0.5), q, 8.0, vio) * 0.45 * part(1.0);
    }
    return col + fx * uFx;
}

// round 15 (Creyon: some blades glowed so much their effects hardly showed): its glow at
// 75 %, so what is drawn round it reads
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_own(g, b, r, px) * 0.75;
}

    let m1 = 0.8 + 0.4 * h11(k + 1.0);
    let s = mix(aaSquare(b.y / 3.0 + b.x * m0, px * (0.34 + m0)), aaSquare(b.y / 3.0 + b.x * m1, px * (0.34 + m1)), q);
    return g * (1.0 - 0.3 * s * part(0.0));
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {

// @part Hologram plans
// @room 6
// @palette {"corona.rim_cool":[0.04,0.20,0.50],"corona.rim_hot":[0.30,0.65,1.0],"corona.inner":[0.75,0.90,1.0],"core.white":[0.92,0.97,1.0],"core.fringe_cool":[0.25,0.55,1.0],"core.fringe_hot":[0.70,0.88,1.0],"light.color":[0.35,0.65,1.0],"trail":[0.40,0.70,1.0]}

// Death Star Plans: the stolen battle station plans as a blade. A cool blueprint-blue blade with
// a bright scan line racing up it; round it, a holographic schematic turns slowly in 3D: thin
// rings of the station's trenches and decks circling it at different heights, a reactor shaft
// line and cross beams, and points of data blinking along them as the plans are read. Now and
// then the schematic flickers like a damaged hologram. A swing makes the projection jitter;
// a clash flashes it and blows the rings outward.
fn dp_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn dp_ring(ro: vec3<f32>, rd: vec3<f32>, y: f32, R: f32) -> f32 {
    var best: f32 = 1.0e3;
    let h = rayAt(ro, rd, y);
    if h.z > 0.0 {
        best = hideD(abs(length(h.xy) - R), behindBlade(ro, rd, h.z));
    }
    let a = dot(rd.xz, rd.xz);
    let b = dot(ro.xz, rd.xz);
    let c = dot(ro.xz, ro.xz) - R * R;
    let dsc = b * b - a * c;
    if dsc > 0.0 && a > 1.0e-6 {
        let q = sqrt(dsc);
        let t0 = (-b - q) / a;
        let t1 = (-b + q) / a;
        if t0 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t0 - y), behindBlade(ro, rd, t0)));
        }
        if t1 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t1 - y), behindBlade(ro, rd, t1)));
        }
    }
    return best;
}

fn base_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let t = uTime;
    let top = dp_top();
    var s: f32;
    var ta: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let blue: vec3<f32> = vec3<f32>(0.35, 0.7, 1.0);
    let pale: vec3<f32> = vec3<f32>(0.8, 0.93, 1.0);
    var col: vec3<f32> = vec3<f32>(0.0);
    if top < 0.5 {
        return col;
    }
    let flick = 0.75 + 0.25 * step(0.15, h11(floor(t * 12.0))) * 1.0 - 0.5 * step(0.93, h11(floor(t * 5.0) + 3.0));
    let jit = 0.08 * sw * (h11(floor(t * 30.0)) - 0.5);
    let o = vec3(jit, 0.0, 0.0);
    // deck rings at different heights and sizes, turning, data points blinking along them
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let y = (0.12 + 0.15 * fi) * uLength;
        if y > top {
            continue;
        }
        let R = (1.2 + 1.6 * h11(fi * 3.7)) * (1.0 + 2.5 * cl * (1.0 - cl));
        let dr = dp_ring(ro - o, rd, y, R);
        col += (blue * halo(dr, max(0.03, px)) * 1.0 + blue * halo(dr, 0.2) * 0.12);
        for (var j = 0; j < 4; j++) {
            let a = h11(fi * 5.0 + f32(j)) + t * (0.05 + 0.03 * fi) * (select(-1.0, 1.0, glsl_mod(fi, 2.0) < 0.5));
            let dk = rayPt(ro - o, rd, around(R, a, y), &ta);
            let bl = step(0.5, fract(t * 1.5 + fi * 0.3 + f32(j) * 0.27));
            col += pale * halo(dk, max(0.06, px)) * 1.5 * bl;
        }
    }
    // the reactor shaft and cross beams, slowly turning
    let rot0 = t * 0.08;
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        let y0 = (0.2 + 0.2 * fi) * uLength;
        if y0 > top {
            continue;
        }
        let a = rot0 + fi * 0.125;
        let d = raySeg(ro - o, rd, around(2.4, a, y0), around(2.4, a + 0.5, y0), &s);
        col += blue * halo(d, max(0.025, px)) * 0.7 * (0.5 + 0.5 * sin(s * 20.0 - t * 4.0));
    }
    // the scan line sweeping a band of light round the schematic
    // round 16 (Creyon: the blade went through the hilt in third person and the preview): the scan
    // starts at the emitter, never below it inside the hilt
    let ys = 0.8 + glsl_mod(t * 12.0, top + 2.0);
    let dsc = dp_ring(ro - o, rd, ys, 2.0);
    col += (pale * halo(dsc, 0.08 + px) * 1.2 + blue * halo(dsc, 0.6) * 0.2) * (1.0 - smoothstep(top, top + 1.5, ys));
    if cl > 0.01 {
        let dc = rayPtRaw(ro, rd, vec3(0.0, uLength * 0.6, 0.0), &ta);
        col += pale * halo(dc, 2.0) * cl * cl * 1.5;
    }
    return col * flick * uFx;
}

// the blade: Sol's glow and core from the file, a bright scan line racing up it
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let ys = 0.8 + glsl_mod(uTime * 12.0, uLength + 2.0);
    // round 23: the dashes' edges smoothed over a pixel (they stair-stepped)
    let ln = 0.85 + 0.15 * aaSquare(b.y * 2.0 - uTime * 3.0, px * 2.0);
    // nothing of it inside the hilt: from the emitter up only (round 16)
    let above = smoothstep(0.0, 0.8, b.y);
    return g * mix(1.0, ln, above) + vec3<f32>(0.8, 0.93, 1.0) * halo(b.y - ys, 0.25) * smoothstep(1.5, 0.0, abs(b.x)) * 1.4 * above;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// round 11: sig_vol gated by part 0
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(0.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    return base_vol(ro, rd, px);
}

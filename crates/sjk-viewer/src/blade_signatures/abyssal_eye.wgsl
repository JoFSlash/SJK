// Generated by scripts/blade_signatures.py from abyssal_eye.glsl: edit that file and run the
// script again.
// @part Shadow tendrils
// @part Abyss glow
// @arcs Crimson lightning
// @motes Lost souls
// @room 10
// @solid 1
// @palette {"corona.rim_cool":[0.30,0.0,0.04],"corona.rim_hot":[0.95,0.12,0.10],"corona.inner":[1.0,0.45,0.30],"core.white":[1.0,0.70,0.55],"core.fringe_cool":[0.70,0.05,0.08],"core.fringe_hot":[1.0,0.40,0.25],"light.color":[0.95,0.12,0.10],"trail":[0.90,0.10,0.10]}

// Abyssal Eye: the blade is a slit cut into an endless dark, its lips glowing crimson (or its
// wearer's colour: a chroma), faint motes
// drifting down into the black. Along its middle the slit peels open into a great almond and an eye
// inside looks out: a burning amber iris with a goat's bar pupil, rolling to watch along the blade,
// darting, blinking, narrowing when you swing; on a clash it flinches shut. The cut is a real
// shape in space, so it keeps its form seen from any side, from above and in first person. Round
// it, shadow tendrils with crimson tips reach out in every direction and curl back, crimson tears
// drip off the lips and fall, specks of light are sucked in from all round, and jagged cracks in
// reality tear outward round the blade, pulse with the abyss's heartbeat and heal. A swing lashes
// the tendrils out; a clash flares a crimson shock ring with the tendrils whipping wide.
fn ae_Ey() -> f32 {
    return uLength * 0.56;
}

const AE_H: f32 = 6.0;

fn ae_top() -> f32 {
    return (uLength + 0.3) * clamp(uAge / 0.45, 0.0, 1.0);
}

// how open the eye is: peels open, stays, blinks, closes; flinches on a clash
fn ae_open() -> f32 {
    let p = glsl_mod(uTime - 1.5, 16.0);
    var o = smoothstep(-0.2, 1.4, p) * (1.0 - smoothstep(12.0, 13.0, p));
    var bl = 1.0 - (1.0 - smoothstep(0.0, 0.10, abs(p - 7.0))) * 0.97;
    bl *= 1.0 - (1.0 - smoothstep(0.0, 0.10, abs(p - 9.6))) * 0.97;
    o *= bl * (1.0 - 0.95 * uClash) * smoothstep(0.3, 0.8, uAge);
    return clamp(o * (1.0 + 0.12 * uSwing), 0.0, 1.15);
}

// where it looks: saccades along the blade (y) and a little across (x), -1..1
fn ae_look() -> vec2<f32> {
    let k = floor(uTime / 1.6);
    let f = smoothstep(0.0, 0.18, fract(uTime / 1.6));
    let a = vec2(h11(k * 3.1) - 0.5, h11(k * 7.7) - 0.5) * vec2<f32>(1.0, 2.0);
    let c = vec2(h11((k + 1.0) * 3.1) - 0.5, h11((k + 1.0) * 7.7) - 0.5) * vec2<f32>(1.0, 2.0);
    let l = mix(a, c, f);
    return clamp(l + vec2(0.0, uSwing * 0.8), vec2(-1.0), vec2(1.0));
}

// the slit's half width at y: a thin cut, opening into the almond round the eye
fn ae_w(y: f32) -> f32 {
    let L = uLength;
    let base = 0.40 * (1.0 - smoothstep(L - 3.0, L, y)) + 0.04;
    let dy = (y - ae_Ey()) / AE_H;
    let alm = 1.38 * ae_open() * pow(max(1.0 - dy * dy, 0.0), 0.75);
    let top = ae_top();
    return max(base, alm) * smoothstep(-0.2, 0.25, y) * (1.0 - smoothstep(top - 0.6, top, y));
}

// the abyss and the eye, seen on the cut at b (across, along)
fn ae_inside(b: vec2<f32>, px: f32) -> vec3<f32> {
    let t = uTime;
    let w = ae_w(b.y);
    // the endless dark: black, a slow crimson haze far down in it, motes sinking away
    var col: vec3<f32> = vec3<f32>(0.012, 0.0, 0.006);
    col += vec3<f32>(0.16, 0.0, 0.03) * fbm3(vec2(b.x * 1.5, b.y * 0.3 + t * 0.15)) * smoothstep(0.0, 0.5, w - abs(b.x));
    let mp = vec2(b.x * 3.0, b.y * 0.9 + t * 0.6);
    let mc = floor(mp);
    col += vec3<f32>(0.9, 0.3, 0.2) * fillD(length(fract(mp) - h22(mc)) - 0.05, px * 3.0) * step(0.86, h21(mc)) * 0.5 * (0.5 + 0.5 * sin(t * 2.0 + mc.y));
    // the eye
    let op = ae_open();
    if op < 0.01 {
        return col;
    }
    let lk = ae_look();
    let ec = vec2(0.0, ae_Ey());
    let ic = ec + vec2(lk.x * 0.22, lk.y * 2.6);
    var q = b - ic;
    let roll = lk.y * 2.6 / AE_H;
    q.y /= mix(1.0, 0.72, abs(roll));
    // the iris foreshortens as it rolls away
    let Ri: f32 = 1.15;
    let d = length(q);
    // a dark, veined sclera in the open almond
    let ey = (b.y - ec.y) / AE_H;
    let sclera = smoothstep(0.0, 0.25, op) * (1.0 - smoothstep(0.85, 1.0, abs(ey)));
    let vein = halo(abs(vn(vec2(b.x * 3.0, b.y * 1.4)) - 0.5), 0.03) * 0.6;
    col = mix(col, vec3<f32>(0.20, 0.03, 0.03) + vec3<f32>(0.45, 0.04, 0.04) * vein, sclera * 0.85);
    // round 19 (Creyon: from above it looked flat): the iris and pupil are a true eyeball in
    // three dimensions now (`ae_eyeball`), sitting in the almond and watching whoever looks
    // the lids' shadow at the almond's edge
    col *= mix(1.0, 0.35, smoothstep(w - 0.25, w, abs(b.x)) * sclera);
    return col;
}

// a shadow tendril i: point at u (0 at the lip .. 1 at the tip)
fn ae_tendril(fi: f32, u: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = (0.08 + 0.85 * fract(fi * 0.618 + 0.1)) * L;
    let a0 = fi * 0.382 + 0.05 * sin(t * 0.4 + fi);
    let reach = (1.8 + 3.6 * h11(fi * 3.3)) * (0.65 + 0.35 * sin(t * 0.7 + fi * 1.9)) + 1.6 * sw + 2.0 * cl;
    let r = ae_w(y0) + 0.05 + reach * u;
    // it writhes like smoke: up and down, and side to side round the blade
    let wave = sin(u * 5.0 - t * 2.2 + fi) * 0.7 * u + u * sin(t * 0.5 + fi) * 0.8 + u * u * (h11(fi * 5.1) - 0.5) * 3.0;
    let curl = u * 0.10 * sin(u * 6.0 - t * 1.7 + fi * 2.3);
    return around(r, a0 + curl, y0 + wave);
}

// the reality cracks: (start, end, fork) for crack i and its life (grow)
fn ae_crack(fi: f32, a: ptr<function, vec3<f32>>, c: ptr<function, vec3<f32>>, m: ptr<function, vec3<f32>>, e: ptr<function, vec3<f32>>, seed: ptr<function, f32>) -> f32 {
    let L = uLength;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let ph = uTime * 0.22 + h11(fi * 9.0);
    let cy = floor(ph);
    let f = fract(ph);
    let y0 = (0.1 + 0.8 * h11(cy * 3.0 + fi)) * L;
    let an = h11(cy * 5.3 + fi * 1.7);
    // round 20 (Creyon: the cracks were swallowed back into the blade, which looked odd): a crack
    // tears out fast, then stays where it reached and fades away there, drifting a little further
    let tear = smoothstep(0.0, 0.18, f);
    let grow = tear * (1.0 - smoothstep(0.35, 1.0, f));
    let reach = (3.0 + 2.6 * h11(cy * 2.0 + fi * 5.0)) * (tear + 0.15 * f) * (1.0 + 0.4 * sw + 0.6 * cl);
    (*a) = around(ae_w(y0) + 0.05, an, y0);
    (*c) = around(ae_w(y0) + 0.05 + reach, an + 0.06 * (h11(cy * 4.0 + fi) - 0.5), y0 + (h11(cy * 7.0 + fi) - 0.5) * reach * 0.9);
    (*m) = mix((*a), (*c), 0.5);
    (*e) = (*m) + ((*c) - (*a)) * 0.45 + vec3(0.0, (select(1.0, -1.0, h11(cy * 11.0 + fi) < 0.5)) * reach * 0.35, 0.0) + around(reach * 0.3, an + 0.25, 0.0);
    (*seed) = cy * 13.0 + fi;
    return grow * step(0.05, reach);
}

// the cut, drawn over Sol's glow and core as his solid blades are: black abyss and the eye
// inside it, its lips burning crimson with a white-hot hairline at the edge
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let top = ae_top();
    if top < 0.3 {
        return o;
    }
    let w = ae_w(b.y);
    let cov = fillD(abs(b.x) - w, px) * step(0.015, w);
    if cov <= 0.0 {
        return o;
    }
    var rgb = ae_inside(b, px);
    let rim = clamp(abs(b.x) / max(w, 0.01), 0.0, 1.0);
    rgb += vec3<f32>(1.0, 0.18, 0.1) * pow(rim, 3.0) * 1.4 + vec3<f32>(1.0, 0.6, 0.45) * pow(rim, 10.0) * 1.2;
    // a chroma (round 14, Creyon): the abyss inside the cut stays black and the eye amber; only
    // its burning lips, the glow and the effects take the wearer's colour
    uOwn = max(uOwn, cov * (1.0 - smoothstep(0.55, 0.85, rim)));
    return vec4(mix(o.rgb, rgb, cov), max(o.a, cov));
}

// round 19: the eye itself, a ball in three dimensions in the almond, so it is round from every
// side, from above and in first person: a dark veined sclera, a burning amber iris with fibres and
// a limbal ring, the goat's bar pupil (across the blade, narrowing on swings) and a wet glint; it
// turns to watch the one looking at it, darting about as it does
fn ae_eyeball(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let op = ae_open();
    if op < 0.05 {
        return vec4<f32>(0.0);
    }
    let c = vec3(0.0, ae_Ey(), 0.0);
    let R = 1.05 * min(op, 1.0);
    var tq: f32;
    let dc = rayPt(ro, rd, c, &tq);
    let cov = fillD(dc - R, px);
    if cov <= 0.0 {
        return vec4<f32>(0.0);
    }
    let back = sqrt(max(R * R - dc * dc, 0.0));
    let n = normalize(ro + rd * (tq - back) - c);
    // its gaze: toward the one watching, darting with its saccades
    let toCam = normalize(ro - c);
    let side = normalize(cross(vec3<f32>(0.0, 1.0, 0.0), toCam) + vec3<f32>(1.0e-4, 0.0, 0.0));
    let up = cross(toCam, side);
    let lk = ae_look();
    let g = normalize(toCam + side * lk.x * 0.35 + up * lk.y * 0.25);
    let gs = normalize(cross(vec3<f32>(0.0, 1.0, 0.0), g) + vec3<f32>(1.0e-4, 0.0, 0.0));
    let gu = cross(g, gs);
    let ca = dot(n, g);
    // the iris's place (radius 1 at its rim, 0.72 rad round the gaze)
    let q = vec2(dot(n, gs), dot(n, gu)) / sin(0.72);
    let t = uTime;
    let Ri: f32 = 1.0;
    let d = length(q) * step(0.0, ca);
    let vein = halo(abs(vn(vec2(n.x * 6.0 + n.z * 3.0, n.y * 5.0)) - 0.5), 0.03) * 0.6;
    var col = vec3<f32>(0.20, 0.03, 0.03) + vec3<f32>(0.45, 0.04, 0.04) * vein;
    col *= 0.45 + 0.55 * max(dot(n, toCam), 0.0);
    let ang = atan2(q.y, q.x);
    let fib = 0.6 + 0.4 * vn(vec2(ang * 9.0, d * 3.0 - t * 0.3));
    var iris = mix(vec3<f32>(1.0, 0.85, 0.30), vec3<f32>(0.95, 0.35, 0.05), smoothstep(0.2, 0.95, d / Ri)) * fib;
    iris += vec3<f32>(1.0, 0.9, 0.5) * halo(abs(d - 0.42 * Ri), 0.08) * 0.5;
    iris *= 1.0 - 0.75 * smoothstep(0.82, 1.0, d / Ri);
    let edge = max(px / max(R * 0.72, 0.01), 0.02);
    let irisA = clamp((Ri - d) / edge + 0.5, 0.0, 1.0) * step(0.0, ca);
    col = mix(col, iris, irisA);
    let ph = mix(0.30, 0.10, clamp(uSwing * 1.5 + 0.4 * sin(t * 0.5) * 0.5 + 0.2, 0.0, 1.0));
    let pup = sdEll(q, vec2(0.66 * Ri, ph));
    col = mix(col, vec3<f32>(0.0), clamp(-pup / edge + 0.5, 0.0, 1.0) * irisA);
    // the wet glint, where the light from above catches it
    let hl = normalize(toCam + vec3<f32>(0.0, 0.9, 0.0) + side * 0.4);
    col += vec3<f32>(1.0, 0.95, 0.9) * pow(max(dot(n, hl), 0.0), 60.0) * 1.2;
    // the lids' shadow toward its rim
    col *= mix(1.0, 0.4, smoothstep(0.55, 1.0, dc / R));
    return vec4(col, cov);
}

// shadow tendrils: dark smoky arms, crimson at the tips, reaching out round the blade in 3D
fn ae_arms(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let L = uLength;
    var col: vec4<f32> = vec4<f32>(0.0);
    let top = ae_top();
    // ---- shadow tendrils: dark smoky arms, crimson at the tips ----
    if uFx > 0.01 && top > L * 0.5 {
        let bx = raySpan(ro, rd, 7.0, 0.0, L + 3.0);
        if bx.y > bx.x {
            for (var i = 0; i < 8; i++) {
                let fi = f32(i);
                var prev = ae_tendril(fi, 0.0);
                for (var k = 1; k <= 6; k++) {
                    let u1 = f32(k) / 6.0;
                    let nx = ae_tendril(fi, u1);
                    var s: f32;
                    let d = raySeg(ro, rd, prev, nx, &s);
                    let u = u1 - (1.0 - s) / 6.0;
                    let th = mix(0.42, 0.04, sqrt(u));
                    if d < th * 2.0 + px * 1.5 {
                        let q = mix(prev, nx, s);
                        let tq = dot(q - ro, rd);
                        if tq > 0.0 {
                            let core = exp(-pow(d / max(th, px * 0.7), 2.0));
                            let aura = exp(-pow(d / max(th * 2.2, px * 1.5), 2.0));
                            let fade = 1.0 - smoothstep(0.75, 1.0, u);
                            let a = max(core * 0.92, aura * 0.45) * fade * uFx;
                            // smoky shadow at the heart of it, its edges and thinning end smouldering crimson
                            let rgb = mix(vec3<f32>(0.9, 0.1, 0.07) * (0.5 + 0.9 * u), vec3<f32>(0.02, 0.0, 0.008), core * (1.0 - u * u));
                            col = vec4(mix(col.rgb, rgb, a), max(col.a, a));
                        }
                    }
                    prev = nx;
                }
            }
        }
    }
    return col;
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let red: vec3<f32> = vec3<f32>(1.0, 0.15, 0.1);
    let top = ae_top();
    // The blade's own light is Sol's glow and core from the file (sig_glow, sig_core).
    var s: f32;
    let o = ae_open();
    var light: vec3<f32> = vec3<f32>(0.0);
    if uFx > 0.01 && top > L * 0.5 {
        var fx: vec3<f32> = vec3<f32>(0.0);
        // crimson tears dripping off the lips and falling
        for (var i = 0; i < 8; i++) {
            let fi = f32(i);
            let rate = 0.35 + 0.2 * h11(fi * 2.1);
            let f = fract(t * rate + h11(fi * 5.5));
            let cyc = floor(t * rate + h11(fi * 5.5));
            let an = h11(fi * 7.0 + cyc * 1.3);
            let y0 = (0.15 + 0.75 * h11(fi * 3.7 + cyc)) * L;
            let p = around(ae_w(y0) + 0.1 + 0.6 * f, an, y0 - 7.0 * f * f);
            var d = raySeg(ro, rd, p, p + vec3(0.0, 0.25 + 1.2 * f, 0.0), &s);
            fx += (vec3<f32>(1.0, 0.5, 0.35) * halo(d, max(0.06, px)) * 1.4 + red * halo(d, 0.3) * 0.4) * (1.0 - f) * smoothstep(0.0, 0.08, f);
        }
        // specks of light sucked in from all round
        for (var i = 0; i < 12; i++) {
            let fi = f32(i);
            let f = fract(t * 0.25 + fi / 12.0);
            let an = fi * 0.137 + t * 0.05 + f * 0.4;
            let p = around(5.2 * (1.0 - f) + 0.5, an, (0.2 + 0.6 * h11(fi)) * L + 2.5 * (1.0 - f) * (h11(fi * 3.0) - 0.5));
            var tq: f32;
            var d = rayPt(ro, rd, p, &tq);
            fx += mix(vec3<f32>(0.9, 0.85, 1.0), red, f) * halo(d, max(0.07, px)) * 1.6 * smoothstep(0.0, 0.2, f);
        }
        // cracks in reality: jagged fissures tearing outward round the blade, pulsing with the
        // abyss's heartbeat, brightest where the eye is looking
        let beat = 0.6 + 0.4 * pow(0.5 + 0.5 * sin(t * 2.2), 8.0);
        let gazeY = ae_Ey() + ae_look().y * 2.6;
        for (var i = 0; i < 4; i++) {
            var a: vec3<f32>;
            var c: vec3<f32>;
            var m: vec3<f32>;
            var e: vec3<f32>;
            var seed: f32;
            let live = ae_crack(f32(i), &a, &c, &m, &e, &seed);
            if live <= 0.0 {
                continue;
            }
            var d = bolt3(ro, rd, a, c, seed, 0.3);
            d = min(d, bolt3(ro, rd, m, e, seed + 3.0, 0.35));
            let nr = 0.5 + 0.9 * halo(abs(a.y - gazeY), 5.0) * o;
            let cc = vec3<f32>(1.0, 0.55, 0.4) * halo(d, max(px, 0.03)) * 1.2 + red * halo(d, 0.2) * 1.2 + vec3<f32>(0.6, 0.0, 0.05) * halo(d, 0.9) * 0.45;
            fx += cc * live * beat * nr;
        }
        // clash: a crimson shock ring and a flash
        if cl > 0.01 {
            let h = rayAt(ro, rd, L * 0.55);
            if h.z > 0.0 {
                fx += red * halo(hideD(abs(length(h.xy) - 1.0 - 6.0 * (1.0 - cl)), behindBlade(ro, rd, h.z)), 0.18 + 0.2 * (1.0 - cl)) * cl * 1.6;
            }
            var tq: f32;
            fx += red * halo(rayPtRaw(ro, rd, vec3(0.0, L * 0.55, 0.0), &tq), 1.2) * pow(cl, 3.0);
        }
        light += fx * uFx;
    }
    return light;
}

// the blade: Sol's glow from the file, pulsing slowly; its core is hidden under the cut
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return g * (0.85 + 0.15 * sin(uTime * 1.7 - b.y * 0.2));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    fx += fxAura(ro, rd, y0, y1, 2.6, vec3<f32>(1.0, 0.1, 0.06)) * part(1.0);
    return col + fx * uFx;
}

// its solid pieces in three dimensions: the eyeball over the shadow tendrils
fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let eye = ae_eyeball(ro, rd, px);
    // the eye keeps its own colours whatever colour its wearer chose (Creyon's round 9)
    uOwn = max(uOwn, eye.a);
    let arms = ae_arms(ro, rd, px);
    return vec4(mix(arms.rgb, eye.rgb, eye.a), max(arms.a, eye.a));
}

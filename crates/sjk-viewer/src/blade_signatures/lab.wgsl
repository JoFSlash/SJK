// Generated by scripts/blade_signatures.py from lab.glsl: edit that file and run the
// script again.

// ---- signature helpers ----
fn h11(p_in: f32) -> f32 {
    var p = p_in;
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

fn h21(p: vec2<f32>) -> f32 {
    var q = fract(vec3(p.xyx) * 0.1031);
    q += vec3(dot(q, q.yzx + 33.33));
    return fract((q.x + q.y) * q.z);
}

fn h22(p: vec2<f32>) -> vec2<f32> {
    var q = fract(vec3(p.xyx) * vec3<f32>(0.1031, 0.1030, 0.0973));
    q += vec3(dot(q, q.yzx + 33.33));
    return fract((q.xx + q.yz) * q.zy);
}

fn vn(p: vec2<f32>) -> f32 {
    let i = floor(p);
    var f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(h21(i), h21(i + vec2<f32>(1.0, 0.0)), f.x), mix(h21(i + vec2<f32>(0.0, 1.0)), h21(i + vec2<f32>(1.0)), f.x), f.y);
}

fn fbm(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    var s: f32 = 0.0;
    var a: f32 = 0.5;
    for (var i = 0; i < 5; i++) {
        s += a * vn(p);
        p = p * 2.03 + vec2<f32>(1.7, 9.2);
        a *= 0.5;
    }
    return s;
}

fn fbm3(p_in: vec2<f32>) -> f32 {
    var p = p_in;
    var s: f32 = 0.0;
    var a: f32 = 0.5;
    for (var i = 0; i < 3; i++) {
        s += a * vn(p);
        p = p * 2.03 + vec2<f32>(1.7, 9.2);
        a *= 0.5;
    }
    return s / 0.875;
}

fn hsv(h: f32, s: f32, v: f32) -> vec3<f32> {
    let p = abs(fract(vec3(h) + vec3<f32>(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return v * mix(vec3<f32>(1.0), clamp(p - 1.0, vec3(0.0), vec3(1.0)), s);
}

fn rot(a: f32) -> mat2x2<f32> {
    let c = cos(a);
    let s = sin(a);
    return mat2x2<f32>(c, -s, s, c);
}

fn sdSeg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 {
    let pa = p - a;
    let ba = b - a;
    let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

fn sdBox(p: vec2<f32>, b: vec2<f32>) -> f32 {
    let d = abs(p) - b;
    return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0);
}

fn sdEll(p: vec2<f32>, r: vec2<f32>) -> f32 {
    let k = length(p / r);
    return (k - 1.0) * min(r.x, r.y);
}

fn fillD(d: f32, px: f32) -> f32 {
    return clamp(0.5 - d / max(px, 1.0e-4), 0.0, 1.0);
}

fn halo(d: f32, w: f32) -> f32 {
    let e = max(d, 0.0) / w;
    return exp(-e * e);
}

fn voro(p: vec2<f32>, cell: ptr<function, vec2<f32>>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    var d1: f32 = 8.0;
    var d2: f32 = 8.0;
    (*cell) = vec2<f32>(0.0);
    for (var y = -1; y <= 1; y++) {
        for (var x = -1; x <= 1; x++) {
            let g = vec2(f32(x), f32(y));
            let o = h22(i + g);
            let d = length(g + o - f);
            if d < d1 {
                d2 = d1;
                d1 = d;
                (*cell) = i + g;
            } else if d < d2 {
                d2 = d;
            }
        }
    }
    return d2 - d1;
}

fn sigBody(b: vec2<f32>, r: f32) -> f32 {
    let y = b.y;
    let L = uLength;
    let beyond = max(y - L, 0.0);
    return length(vec2(b.x, beyond)) / r * step(-1.0, y);
}

// ---- SJK effect helpers (shared by the signatures; Creyon's round 7) ----
// Distance from p to a jagged lightning bolt from a to c: 10 kinks, displaced across the
// line by up to jag of its length, the kinks chosen by seed (strike anew by changing it).
fn boltD(p: vec2<f32>, a: vec2<f32>, c: vec2<f32>, seed: f32, jag: f32) -> f32 {
    let d = c - a;
    let L = max(length(d), 1.0e-3);
    let n = vec2(-d.y, d.x) / L;
    var best: f32 = 1.0e3;
    var prev = a;
    for (var i = 1; i <= 10; i++) {
        let f = f32(i) / 10.0;
        let off = select((h11(seed * 17.13 + f32(i) * 7.31) - 0.5) * jag * L * sin(f * 3.1416), 0.0, i == 10);
        let q = a + d * f + n * off;
        best = min(best, sdSeg(p, prev, q));
        prev = q;
    }
    return best;
}

// A bolt's light: a white-hot thread in a coloured glow, never thinner than a pixel.
fn boltLight(dist: f32, col: vec3<f32>, px: f32) -> vec3<f32> {
    return vec3<f32>(1.0) * halo(dist, max(px, 0.035)) * 1.6 + col * halo(dist, 0.22) * 0.9 + col * halo(dist, 0.9) * 0.18;
}

// A Storm-like loop: a bolt that leaves the blade at height y0, arcs out to reach units on
// side s and comes back in at y1, struck anew rate times a second.
fn arcLoop(b: vec2<f32>, y0: f32, y1: f32, s: f32, reach: f32, seed: f32, rate: f32, col: vec3<f32>, px: f32) -> vec3<f32> {
    let k = floor(uTime * rate + seed * 13.0);
    let a = vec2(0.0, y0);
    let c = vec2(0.0, y1);
    let m = vec2(s * reach * (0.75 + 0.25 * h11(k + seed)), mix(y0, y1, 0.5) + (h11(k * 1.7 + seed) - 0.5) * 2.0);
    let d = min(boltD(b, a, m, k + seed, 0.45), boltD(b, m, c, k + seed + 0.5, 0.45));
    return boltLight(d, col, px);
}

// A helix strand wound round the blade: across (x) and how near the viewer it is (z, -1..1)
// at height y, turns per 10 units, phase turns, radius r.
fn helix(y: f32, r: f32, turns: f32, phase: f32) -> vec2<f32> {
    let a = 6.2832 * (y * turns / 10.0 + phase);
    return vec2(r * sin(a), cos(a));
}

// ---- 3D helpers (round 8): effects drawn along the true view ray ----
// In sig_vol(ro, rd, px) a signature gets the view ray in the blade's frame: ro the camera,
// rd its unit direction, y along the blade from the hilt, x across it to the camera's side,
// z toward the camera. Everything placed with these sits round the blade in depth and keeps
// its shape from every side, from above and in first person.
// Round 22 (Creyon: nothing may be seen through the blade when it is behind it): how hidden by
// the blade's body a point t along the ray is, 0 (seen) to 1 (hidden): the ray passes through the
// blade's body (its nearest approach to the axis within the blade) before reaching it.
// Round 23 (players' reports after the 2026.1021.1 release: hard-edged boxes and lines round
// the tip when a blade pointed at the camera): it fades in and out softly; it used to switch
// off at once when looking nearly along the blade.
fn behindBlade(ro: vec3<f32>, rd: vec3<f32>, t: f32) -> f32 {
    let a = dot(rd.xz, rd.xz);
    let along = smoothstep(0.01, 0.04, a);
    if along <= 0.0 {
        return 0.0;
    }
    let ta = -dot(ro.xz, rd.xz) / a;
    let y = ro.y + rd.y * ta;
    let off = ro.xz + rd.xz * ta;
    let d = length(off);
    // what lies on the blade's own body (its axis, its glow) is never hidden by it
    let p = ro + rd * t;
    let outside = smoothstep(0.5, 0.9, length(p.xz));
    // round 23: the body hiding narrows with the blade's rounded tip (a quarter circle over its
    // last 1.4 units) down to the point, so what passes behind the tip is hidden too (Sol's review:
    // ending the hiding before the tip let Exegol Rift's flare and Quasar's jet show through),
    // without the dark round end past the tip that a full-width hiding drew seen end on
    let into = clamp((y - (uLength - 1.4)) / 1.4, 0.0, 1.0);
    let w = sqrt(max(1.0 - into * into, 0.0));
    let onBlade = smoothstep(-0.8, -0.2, y) * (1.0 - smoothstep(uLength - 0.15, uLength + 0.05, y));
    return (1.0 - smoothstep(0.35 * w, 0.8 * w + 0.02, d)) * onBlade * outside * smoothstep(ta + 0.15, ta + 0.7, t) * along;
}

// A distance d as seen when h (behindBlade) of it is hidden by the blade: unchanged at 0, out of
// reach at 1, and in between the piece narrows and dims, so whatever passes behind the blade fades
// out over the blade's soft edge. Round 23: adding 1e3*h hid a piece wherever h was more than a
// thousandth, a hard cut along the blade's body that showed as a box round the tip when the blade
// pointed at the camera.
fn hideD(d: f32, h: f32) -> f32 {
    return d / max(1.0 - h, 1.0e-3) + h;
}

// The distance from the ray to point p, as seen (a point the blade hides is far off); t
// returns how far along the ray that is.
fn rayPtRaw(ro: vec3<f32>, rd: vec3<f32>, p: vec3<f32>, t: ptr<function, f32>) -> f32 {
    (*t) = max(dot(p - ro, rd), 0.0);
    return length(ro + rd * (*t) - p);
}

fn rayPt(ro: vec3<f32>, rd: vec3<f32>, p: vec3<f32>, t: ptr<function, f32>) -> f32 {
    let d = rayPtRaw(ro, rd, p, t);
    return hideD(d, behindBlade(ro, rd, (*t)));
}

// The distance from the ray to the segment a-b; s returns where on it (0 at a, 1 at b); the
// raw one ignores the blade's body (for bounds and the blade's own axis).
fn raySegRaw(ro: vec3<f32>, rd: vec3<f32>, a: vec3<f32>, b: vec3<f32>, s: ptr<function, f32>) -> f32 {
    let ba = b - a;
    let w = ro - a;
    let bd = dot(rd, ba);
    let bb = dot(ba, ba);
    let dw = dot(rd, w);
    let bw = dot(ba, w);
    let den = max(bb - bd * bd, 1.0e-6);
    (*s) = clamp((bw - bd * dw) / den, 0.0, 1.0);
    let q = a + ba * (*s);
    let t = max(dot(q - ro, rd), 0.0);
    let pr = ro + rd * t;
    (*s) = clamp(dot(pr - a, ba) / max(bb, 1.0e-6), 0.0, 1.0);
    return length(pr - (a + ba * (*s)));
}

fn raySeg(ro: vec3<f32>, rd: vec3<f32>, a: vec3<f32>, b: vec3<f32>, s: ptr<function, f32>) -> f32 {
    let d = raySegRaw(ro, rd, a, b, s);
    let q = a + (b - a) * (*s);
    return hideD(d, behindBlade(ro, rd, max(dot(q - ro, rd), 0.0)));
}

// Where the ray crosses the plane across the blade at height h: xz there, and t (negative:
// never, or behind the camera).
fn rayAt(ro: vec3<f32>, rd: vec3<f32>, h: f32) -> vec3<f32> {
    let t = select(-1.0, (h - ro.y) / rd.y, abs(rd.y) > 1.0e-5);
    let p = ro + rd * max(t, 0.0);
    return vec3(p.x, p.z, t);
}

// Where the ray is within R of the blade's axis and between heights y0 and y1: the span of
// t (empty when x >= y).
fn raySpan(ro: vec3<f32>, rd: vec3<f32>, R: f32, y0: f32, y1: f32) -> vec2<f32> {
    let a = dot(rd.xz, rd.xz);
    let b = dot(ro.xz, rd.xz);
    let c = dot(ro.xz, ro.xz) - R * R;
    var s: vec2<f32> = vec2<f32>(0.0, 1.0e5);
    if a < 1.0e-6 {
        if c > 0.0 {
            return vec2<f32>(1.0, 0.0);
        }
    } else {
        var h = b * b - a * c;
        if h < 0.0 {
            return vec2<f32>(1.0, 0.0);
        }
        h = sqrt(h);
        s = vec2((-b - h) / a, (-b + h) / a);
    }
    if abs(rd.y) > 1.0e-6 {
        let ta = (y0 - ro.y) / rd.y;
        let tb = (y1 - ro.y) / rd.y;
        s = vec2(max(s.x, min(ta, tb)), min(s.y, max(ta, tb)));
    } else if ro.y < y0 || ro.y > y1 {
        return vec2<f32>(1.0, 0.0);
    }
    s.x = max(s.x, 0.0);
    return s;
}

// round 19: `p` turned a (turns) round the blade's axis, for a piece laid out in the blade's
// picture (x across, y up) to stand at its own place round the blade in three dimensions.
fn turnY(p: vec3<f32>, a: f32) -> vec3<f32> {
    let c = cos(6.2832 * a);
    let s = sin(6.2832 * a);
    return vec3(p.x * c + p.z * s, p.y, -p.x * s + p.z * c);
}

// A point round the blade: radius r, angle a (turns), height y.
fn around(r: f32, a: f32, y: f32) -> vec3<f32> {
    return vec3(r * sin(6.2832 * a), y, r * cos(6.2832 * a));
}

// The blade itself in three dimensions: a white-hot core and a coloured glow round the
// axis from just inside the hilt to the tip. It fills the hilt's mouth as a stock blade
// does, seen from any side, from above and in first person. w is the core's half width.
fn blade3(ro: vec3<f32>, rd: vec3<f32>, px: f32, col: vec3<f32>, w: f32, top: f32) -> vec3<f32> {
    var s: f32;
    let d = raySegRaw(ro, rd, vec3<f32>(0.0, -0.6, 0.0), vec3(0.0, top, 0.0), &s);
    return vec3<f32>(1.0) * exp(-pow(d / max(w, px), 2.0)) * 1.4 + col * halo(d, w * 2.2) * 0.75 + col * halo(d, w * 6.0) * 0.18;
}

// A lightning bolt in three dimensions from a to c: 10 kinks, each pushed off the line in
// both directions across it by up to jag of its length.
fn bolt3(ro: vec3<f32>, rd: vec3<f32>, a: vec3<f32>, c: vec3<f32>, seed: f32, jag: f32) -> f32 {
    let d = c - a;
    let L = max(length(d), 1.0e-3);
    let n1 = normalize(cross(d, select(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), abs(d.y) < 0.9 * L)));
    let n2 = cross(d / L, n1);
    var best: f32 = 1.0e3;
    var prev = a;
    var s: f32;
    for (var i = 1; i <= 10; i++) {
        let f = f32(i) / 10.0;
        let k = select(sin(f * 3.1416) * jag * L, 0.0, i == 10);
        let q = a + d * f + (n1 * (h11(seed * 17.13 + f32(i) * 7.31) - 0.5) + n2 * (h11(seed * 5.71 + f32(i) * 3.17) - 0.5)) * k;
        best = min(best, raySeg(ro, rd, prev, q, &s));
        prev = q;
    }
    return best;
}

// A soft cloud of light: march the ray through a smooth density inside radius R between
// heights y0 and y1 in n steps (the caller sums its own field; this gives the steps).
// Returns the span and the step length in z.
fn marchSteps(ro: vec3<f32>, rd: vec3<f32>, R: f32, y0: f32, y1: f32, n: f32) -> vec3<f32> {
    let s = raySpan(ro, rd, R, y0, y1);
    return vec3(s, max(s.y - s.x, 0.0) / n);
}

// ---- round 9: the big effects (Creyon: "dramatic and beautiful, like beams, strays, rays") ----
// Every one is placed in the blade's own frame (fixed to the hilt), sized in units, and fades
// in and out smoothly; the loops have constant bounds and stop at `count`.
// How near the ray passes the blade's axis between heights y0 and y1 (for early outs).
fn fxNear(ro: vec3<f32>, rd: vec3<f32>, y0: f32, y1: f32) -> f32 {
    var s: f32;
    return raySegRaw(ro, rd, vec3(0.0, y0, 0.0), vec3(0.0, y1, 0.0), &s);
}

// The ray's distance to a ring of radius R round the blade at height y: the nearer of where
// it crosses the ring's plane and the ring's cylinder (smooth from any side).
fn ringD(ro: vec3<f32>, rd: vec3<f32>, y: f32, R: f32) -> f32 {
    var best: f32 = 1.0e3;
    let h = rayAt(ro, rd, y);
    if h.z > 0.0 {
        best = hideD(abs(length(h.xy) - R), behindBlade(ro, rd, h.z));
    }
    let a = dot(rd.xz, rd.xz);
    let b = dot(ro.xz, rd.xz);
    let c = dot(ro.xz, ro.xz) - R * R;
    let dsc = b * b - a * c;
    if dsc > 0.0 && a > 1.0e-6 {
        let q = sqrt(dsc);
        let t0 = (-b - q) / a;
        let t1 = (-b + q) / a;
        if t0 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t0 - y), behindBlade(ro, rd, t0)));
        }
        if t1 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t1 - y), behindBlade(ro, rd, t1)));
        }
    }
    return best;
}

// A star flare at p facing the camera: a white-hot heart of radius size and n thin rays of
// length len, turned by spin (radians).
fn fxFlare(ro: vec3<f32>, rd: vec3<f32>, p: vec3<f32>, px: f32, size: f32, len: f32, n: f32, spin: f32, col: vec3<f32>) -> vec3<f32> {
    var t: f32;
    let d = rayPt(ro, rd, p, &t);
    // round 23: skipped only past its widest halo (size*8), which fades to nothing before the cut
    // (at size*4 it was still a tenth as bright and ended at a hard ring round the flare; Sol's
    // review: size*18 cost too much, size*12 with the taper below is as clean)
    if d > len + size * 12.0 {
        return vec3<f32>(0.0);
    }
    let q = ro + rd * t - p;
    let u = normalize(cross(rd, select(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), abs(rd.y) < 0.9)));
    let v = cross(rd, u);
    let e = vec2(dot(q, u), dot(q, v));
    let r = length(e);
    let k = 6.2832 / max(n, 1.0);
    let aa = glsl_mod(atan2(e.y, e.x) + spin + k * 0.5, k) - k * 0.5;
    let across = abs(r * sin(aa));
    let along = r * cos(aa);
    let w = max(px, 0.03 + 0.012 * along);
    let ray = exp(-pow(across / w, 2.0)) * exp(-max(along, 0.0) / max(len, 0.01) * 2.6) * step(0.0, along);
    let wide = halo(d, size * 8.0) * (1.0 - smoothstep(len + size * 7.0, len + size * 12.0, d));
    return (vec3<f32>(1.0) * (halo(d, max(size, px)) * 1.8 + ray * 0.9) + col * (halo(d, size * 3.0) * 0.7 + ray * 0.8 + wide * 0.15)) * roomAt(p);
}

// Beams of light shooting out of the blade between heights y0 and y1: count of them (up to
// 24), each up to len long, flaring out and fading rate times a second, seed chooses them.
fn fxRays(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, count: f32, len: f32, rate: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    // round 23: past the beams' widest glow (nine of their widths), which ended at a hard edge
    if fxNear(ro, rd, y0, y1) > len * 1.6 + 5.0 {
        return acc;
    }
    var s: f32;
    for (var i = 0; i < 24; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        let cyc = uTime * rate * (0.8 + 0.4 * h11(fi * 3.3 + seed)) + h11(fi * 7.13 + seed);
        let k = floor(cyc);
        let q = fract(cyc);
        let y = mix(y0, y1, h11(k * 3.1 + fi * 1.7 + seed));
        let a = h11(k * 5.7 + fi * 2.3 + seed);
        let tilt = (h11(k * 2.9 + fi + seed) - 0.5) * 0.9;
        let dir = normalize(vec3(sin(6.2832 * a), tilt, cos(6.2832 * a)));
        let lr = min(len * (0.55 + 0.6 * h11(k * 1.3 + fi + seed)), 0.85 * uReach) * smoothstep(0.0, 0.3, q);
        let a0 = vec3(0.0, y, 0.0) + dir * 0.35;
        let d = raySeg(ro, rd, a0, a0 + dir * max(lr, 0.01), &s);
        let env = sin(3.1416 * q);
        let w = mix(0.3, 0.07, s);
        acc += (vec3<f32>(1.0) * halo(d, max(w * 0.45, px)) * 1.4 + col * halo(d, w * 3.0) * 0.95 + col * halo(d, w * 9.0) * 0.22) * (1.0 - 0.75 * s) * env;
    }
    return acc;
}

// A bolt's light (boltLight) faded to nothing 1.7 from it, so fxArcs can skip a bolt past that
// without a seam: its widest glow is a fortieth as bright there.
fn arcGlow(dist: f32, col: vec3<f32>, px: f32) -> vec3<f32> {
    return boltLight(dist, col, px) * (1.0 - smoothstep(1.1, 1.7, dist));
}

// Lightning in three dimensions: count (up to 10) bolts that leave the blade between y0 and
// y1, arc out up to reach units on every side and come back in, with a fork, struck anew
// rate times a second (Sol's Storm, all round the blade).
fn fxArcs(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, count: f32, reach: f32, rate: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    // round 23: past the forks' reach (half again the bolt's, which the blade's room caps at 0.6 of
    // it) and their glow, which ended at a hard edge
    if fxNear(ro, rd, y0, y1) > min(reach, 0.6 * uReach) * 1.6 + 3.0 {
        return acc;
    }
    var t: f32;
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        let cyc = uTime * rate * (0.7 + 0.6 * h11(fi * 1.9 + seed)) + h11(fi * 3.3 + seed) * 5.0;
        let k = floor(cyc);
        let q = fract(cyc);
        let ya = mix(y0, y1, h11(k * 1.9 + fi * 2.7 + seed));
        let yb = min(ya + 3.0 + 6.0 * h11(k * 2.3 + fi + seed), y1 + 2.0);
        let a = h11(k * 4.1 + fi * 2.0 + seed);
        let R = min(reach, 0.6 * uReach) * (0.45 + 0.55 * h11(k * 7.7 + fi + seed));
        let mid = around(R, a, mix(ya, yb, 0.5) + (h11(k * 9.1 + fi) - 0.5) * 2.0);
        // round 23 (Sol's review: timed on Creyon's RTX 5070, the arc blades cost a fifth to a third
        // more once their glow faded out instead of being cut): each of the arc's three bolts (its two
        // halves and the fork) is drawn only near its own middle. A bolt's points lie within half its
        // length of its middle (its zigzag reaches less aside than that), and its glow is made to end
        // 1.7 past them (arcGlow), so a pixel further off would draw nothing from it.
        if rayPtRaw(ro, rd, mid, &t) > R * 1.25 + (yb - ya) * 0.65 + 2.8 {
            continue;
        }
        let env = (1.0 - q) * (1.0 - q) * (0.6 + 0.4 * step(0.5, fract(q * 9.0 + fi)));
        let ea = around(0.25, a, ya);
        let eb = around(0.25, a, yb);
        let fork = mid + around(R * 0.55, a + 0.12 * (h11(k + fi) - 0.5), (h11(k * 3.3 + fi) - 0.5) * 3.0);
        var d: f32 = 1.0e3;
        var d2: f32 = 1.0e3;
        if rayPtRaw(ro, rd, (ea + mid) * 0.5, &t) < 0.55 * length(mid - ea) + 1.8 + px {
            d = bolt3(ro, rd, ea, mid, k + fi * 1.37 + seed, 0.5);
        }
        if rayPtRaw(ro, rd, (mid + eb) * 0.5, &t) < 0.55 * length(eb - mid) + 1.8 + px {
            d = min(d, bolt3(ro, rd, mid, eb, k + fi * 1.37 + seed + 0.5, 0.5));
        }
        if rayPtRaw(ro, rd, (mid + fork) * 0.5, &t) < 0.55 * length(fork - mid) + 1.8 + px {
            d2 = bolt3(ro, rd, mid, fork, k * 2.1 + fi + seed, 0.6);
        }
        acc += (arcGlow(d, col, px) + arcGlow(d2, col, px) * 0.55) * env;
    }
    return acc;
}

// Sparks spraying off the blade between y0 and y1: count (up to 32) streaks flying out up
// to len units, white-hot then cooling to col, rate cycles a second.
fn fxSparks(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, count: f32, len: f32, rate: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > len + 1.5 {
        return acc;
    }
    var s: f32;
    for (var i = 0; i < 32; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        let cyc = uTime * rate * (0.7 + 0.6 * h11(fi * 2.1 + seed)) + h11(fi * 5.9 + seed);
        let k = floor(cyc);
        let q = fract(cyc);
        let y = mix(y0, y1, h11(k * 2.7 + fi * 1.3 + seed));
        let a = h11(k * 6.3 + fi * 0.7 + seed);
        let dir = normalize(vec3(sin(6.2832 * a), 0.2 + 0.9 * (h11(k * 1.1 + fi + seed) - 0.3), cos(6.2832 * a)));
        let v = min(len, 0.85 * uReach) * (0.5 + 0.5 * h11(k * 4.4 + fi + seed));
        let o = around(0.3, a, y);
        let e1 = 1.0 - exp(-q * 3.0);
        let e0 = 1.0 - exp(-max(q - 0.07, 0.0) * 3.0);
        let d = raySeg(ro, rd, o + dir * v * e0, o + dir * v * e1, &s);
        let life = 1.0 - smoothstep(0.55, 1.0, q);
        acc += mix(vec3<f32>(1.0, 0.97, 0.9), col, smoothstep(0.0, 0.6, q)) * (halo(d, max(0.05, px)) * 2.0 + halo(d, 0.28) * 0.3) * life;
    }
    return acc;
}

// Coils of light wound round the blade from y0 to y1 at radius R, turns per 10 units,
// travelling up at speed; knots of light run along them. count (up to 4) strands.
fn fxCoils(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, R: f32, turns: f32, speed: f32, count: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    // round 23: past the coils' widest glow (it ended at a hard edge, R + 1.5)
    if fxNear(ro, rd, y0, y1) > R + 2.5 {
        return acc;
    }
    var s: f32;
    for (var j = 0; j < 4; j++) {
        let fj = f32(j);
        if fj >= count {
            break;
        }
        var best: f32 = 1.0e3;
        var bf: f32 = 0.0;
        var prev: vec3<f32> = vec3<f32>(0.0);
        for (var i = 0; i <= 24; i++) {
            let f = f32(i) / 24.0;
            let y = mix(y0, y1, f);
            let p = around(R * (0.85 + 0.15 * sin(f * 12.0 + uTime * 2.0 + fj)), y * turns / 10.0 - uTime * speed + fj / max(count, 1.0), y);
            if i > 0 {
                let d = raySeg(ro, rd, prev, p, &s);
                if d < best {
                    best = d;
                    bf = (f32(i) - 1.0 + s) / 24.0;
                }
            }
            prev = p;
        }
        let knot = pow(0.5 + 0.5 * sin(bf * 40.0 - uTime * 9.0 + fj * 2.0), 6.0);
        let ends = smoothstep(0.0, 0.08, bf) * (1.0 - smoothstep(0.9, 1.0, bf));
        acc += (vec3<f32>(1.0) * halo(best, max(0.05, px)) * (0.5 + 1.5 * knot) + col * halo(best, 0.3) * (0.5 + knot) + col * halo(best, 1.0) * 0.12) * ends;
    }
    return acc;
}

// Motes (dust, embers, sparks of light) drifting up round the blade between radii r0 and r1:
// count (up to 40), each a soft point that twinkles.
fn fxMotes(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, r0: f32, r1: f32, count: f32, speed: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > r1 + 1.0 {
        return acc;
    }
    var t: f32;
    for (var i = 0; i < 40; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        let f = fract(uTime * speed * (0.6 + 0.8 * h11(fi * 2.9 + seed)) + h11(fi * 5.1 + seed));
        let y = mix(y0 - 1.0, y1 + 2.0, f);
        let p = around(mix(r0, r1, h11(fi * 3.7 + seed)), h11(fi * 1.9 + seed) + uTime * 0.04 + 0.08 * sin(uTime * 0.7 + fi), y);
        let d = rayPt(ro, rd, p, &t);
        let tw = 0.55 + 0.45 * sin(uTime * 5.0 + fi * 2.3);
        acc += col * (halo(d, max(0.07, px)) * 1.8 + halo(d, 0.35) * 0.2) * tw * smoothstep(0.0, 0.1, f) * (1.0 - smoothstep(0.8, 1.0, f)) * roomAt(p);
    }
    return acc;
}

// A shock ring racing out from the blade at height y: q its age (0 to 1), out to R.
fn fxShock(ro: vec3<f32>, rd: vec3<f32>, px: f32, y: f32, q: f32, R: f32, col: vec3<f32>) -> vec3<f32> {
    if q <= 0.0 || q >= 1.0 {
        return vec3<f32>(0.0);
    }
    let Rr = 0.5 + R * (1.0 - pow(1.0 - q, 2.0));
    let d = ringD(ro, rd, y, Rr);
    let env = (1.0 - q) * smoothstep(0.0, 0.05, q) * roomFade(Rr + 0.8);
    return (vec3<f32>(1.0) * halo(d, max(0.07, px)) * 1.4 + col * halo(d, 0.45) * 0.7 + col * halo(d, 1.4) * 0.15) * env;
}

// A wide soft aura round the blade from y0 to y1: its light reaching w units out.
fn fxAura(ro: vec3<f32>, rd: vec3<f32>, y0: f32, y1: f32, w: f32, col: vec3<f32>) -> vec3<f32> {
    let d = fxNear(ro, rd, y0, y1);
    return col * (halo(d, w) * 0.35 + halo(d, w * 0.4) * 0.25);
}

// ---- round 11: small helpers for the lower tiers ----
// The glow's level and the glow at that level in colour c (a tint keeping Sol's shape).
fn lvl(g: vec3<f32>) -> f32 {
    return max(g.r, max(g.g, g.b));
}

fn recol(g: vec3<f32>, c: vec3<f32>) -> vec3<f32> {
    return lvl(g) * c;
}

// Bands of light travelling along the blade: k bands a unit, moving at v units a second.
fn bands(y: f32, k: f32, v: f32) -> f32 {
    return 0.5 + 0.5 * sin(y * k * 6.2832 - uTime * v * k * 6.2832);
}

// Falling streaks (rain, snow, ash) in the blade's picture: count of them (up to 32) between
// heights y0 and y1, reaching r across, falling at v, slanted by lean.
fn fxFall(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, r: f32, count: f32, v: f32, len: f32, lean: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    // round 23: the streaks start up to 2 units past y0 and y1 and reach len further (leaning
    // lean*len aside): skipped only outside all that (Lightspeed Ram's rising streaks were cut
    // above the tip)
    if fxNear(ro, rd, y0 - 2.0 + min(len, 0.0), y1 + 2.0 + max(len, 0.0)) > r + abs(lean * len) + 1.0 {
        return acc;
    }
    var s: f32;
    for (var i = 0; i < 32; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        let f = fract(uTime * v / (y1 - y0 + 4.0) * (0.7 + 0.6 * h11(fi * 2.3 + seed)) + h11(fi * 5.9 + seed));
        let y = mix(y1 + 2.0, y0 - 2.0, f);
        let p = around(0.8 + (min(r, 0.9 * uReach) - 0.8) * h11(fi * 3.1 + seed), h11(fi * 7.7 + seed), y);
        let q = p + vec3(lean, 1.0, 0.0) * len;
        let d = raySeg(ro, rd, p, q, &s);
        acc += col * (halo(d, max(0.04, px)) * 1.2 + halo(d, 0.2) * 0.2) * (1.0 - 0.6 * s);
    }
    return acc;
}

// ---- round 11: every effect can be switched off ----
// 1 while the signature's own part k (its `// @part` line k, from 0) is on, 0 when its wearer
// switched it off in the Collection.
fn part(k: f32) -> f32 {
    return 1.0 - glsl_mod(floor(uParts / exp2(k) + 0.001), 2.0);
}

// ---- round 19: nothing is ever cut at the quad's edge ----
// How much of what lies r units from the blade's axis shows: all of it well inside the reach
// the blade's quad holds without fading (`uReach`), fading smoothly to nothing before it
// (Creyon: Reactor's shock ring was cut off where it left that room).
fn roomFade(r: f32) -> f32 {
    return 1.0 - smoothstep(0.72 * uReach, 0.97 * uReach, r);
}

fn roomAt(p: vec3<f32>) -> f32 {
    return roomFade(length(p.xz));
}

// ---- round 23: sharp patterns without stair steps (players' reports after 2026.1021.1) ----
// A step from 0 to 1 at e, smoothed over w (a pixel, in x's units): a pattern's edge stays sharp
// but no longer stair-steps or flickers as the blade moves.
fn aaStep(e: f32, x: f32, w: f32) -> f32 {
    return smoothstep(e - 0.5 * w, e + 0.5 * w, x);
}

// How far a pixel is into the next cell of u (cells one long), over the cell's last w (a pixel in
// u's units, and at least a twelfth of the cell, as px is the pixel across the blade and a pixel
// along it is longer where the blade is seen end on): blending a cell's value into the next one's
// by it keeps blocks and stripes sharp.
fn cellMix(u: f32, w: f32) -> f32 {
    return smoothstep(1.0 - clamp(w, 0.08, 0.5), 1.0, fract(u));
}

// A square wave of u, 0 for the first half of each one-long cell and 1 for the second, its two
// edges smoothed over w (a pixel in u's units, at least a twelfth of the cell, as cellMix).
fn aaSquare(u: f32, w_in: f32) -> f32 {
    var w = w_in;
    let f = fract(u);
    w = clamp(w, 0.08, 0.25);
    return aaStep(0.5, f, w) * (1.0 - smoothstep(1.0 - w, 1.0, f));
}

// ---- round 12: richer pieces for the lower tiers (each blade sets its own pattern) ----
// Soft curling smoke round the blade between heights y0 and y1, w units to each side at its
// thickest, rising at `rise` units a second (negative sinks): warped smooth noise with no hard
// edge (Creyon's round 12: "the smoke looks so squary"). Round 19 (Creyon: seen from above, the
// smoke was a flat sheet following the camera): a cloud in three dimensions, the ray marched
// through it in six steps, as bright side on as the old sheet.
fn fxSmokeAt(p: vec3<f32>, w: f32, y0: f32, y1: f32, rise: f32, seed: f32) -> f32 {
    let ax = length(p.xz);
    var q = vec2((p.x + 0.62 * p.z) * 0.32, p.y * 0.12 - uTime * rise * 0.12) + vec2(seed * 7.3, seed * 3.1);
    q += vec2(0.0, p.z * 0.09 - p.x * 0.05);
    let warp = vec2(vn(rot(0.6) * q * 0.9 + vec2(0.0, uTime * 0.07)), vn(rot(2.1) * q * 0.9 + vec2(5.2, -uTime * 0.06)));
    let r = q + 1.3 * warp;
    let n = 0.6 * vn(rot(0.35) * r) + 0.4 * vn(rot(1.7) * r * 2.1 + vec2<f32>(3.3, 1.1) + vec2(p.z * 0.2, -p.x * 0.2));
    let shape = exp(-pow(ax / w, 2.0)) * smoothstep(y0 - 3.0, y0 + 2.0, p.y) * (1.0 - smoothstep(y1 - 7.0, y1 - 1.0, p.y));
    return smoothstep(0.35, 0.8, n) * shape;
}

// Round 23 (players' reports after 2026.1021.1: a hard-edged dome in the smoke seen along the
// blade): a step at most about a third of the cloud's width, up to 12 of them (16 cost the smoke
// blades up to a sixth more seen along them, Sol's review), so a long path through it (looking
// along the blade) is not sampled six units apart; seen from the side the path is short and it
// still takes six.
fn fxSmoke(ro: vec3<f32>, rd: vec3<f32>, y0: f32, y1: f32, w: f32, rise: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    let span = raySpan(ro, rd, w * 2.4, y0 - 3.0, y1);
    if span.x >= span.y {
        return vec3<f32>(0.0);
    }
    let n = clamp(ceil((span.y - span.x) / (0.8 * w)), 6.0, 12.0);
    let dt = (span.y - span.x) / n;
    var acc: f32 = 0.0;
    for (var i = 0; i < 12; i++) {
        if f32(i) >= n {
            break;
        }
        let ts = span.x + (f32(i) + 0.5) * dt;
        acc += fxSmokeAt(ro + rd * ts, w, y0, y1, rise, seed) * (1.0 - behindBlade(ro, rd, ts));
    }
    return col * acc * dt / (1.77 * w) * 0.9;
}

// Ribbons of energy flowing along the blade: count (up to 4) wavy strands alternating sides,
// R units out at most, `wave` their waviness, pulses of light running up them at `speed`.
fn fxStreams(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, count: f32, R: f32, wave: f32, speed: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > R + 1.5 {
        return acc;
    }
    var s: f32;
    for (var j = 0; j < 4; j++) {
        let fj = f32(j);
        if fj >= count {
            break;
        }
        var best: f32 = 1.0e3;
        var bf: f32 = 0.0;
        var prev: vec3<f32> = vec3<f32>(0.0);
        // round 19: each strand on its own side all round the blade, in three dimensions (it lay
        // in one flat sheet)
        let side = fj / max(count, 1.0) + 0.13 * seed;
        for (var i = 0; i <= 14; i++) {
            let f = f32(i) / 14.0;
            let y = mix(y0, y1, f);
            let x = 0.45 + (min(R, 0.9 * uReach) - 0.45) * (0.5 + 0.5 * sin(y * wave + fj * 1.7 + seed + uTime * (0.5 + 0.2 * fj)));
            let p = around(x, side + 0.05 * sin(y * 0.15 + uTime * 0.3 + fj), y);
            if i > 0 {
                let d = raySeg(ro, rd, prev, p, &s);
                if d < best {
                    best = d;
                    bf = (f32(i) - 1.0 + s) / 14.0;
                }
            }
            prev = p;
        }
        let pulse = pow(0.5 + 0.5 * sin(bf * 18.0 - uTime * speed + fj * 2.1 + seed), 4.0);
        let ends = smoothstep(0.0, 0.1, bf) * (1.0 - smoothstep(0.85, 1.0, bf));
        acc += (vec3<f32>(1.0) * halo(best, max(0.035, px)) * (0.25 + 1.1 * pulse) + col * halo(best, 0.22) * (0.35 + 0.8 * pulse) + col * halo(best, 0.9) * 0.07) * ends;
    }
    return acc;
}

// Flakes of light (snow, ash, petals, leaves of light) drifting down round the blade: count
// (up to 24) soft flat ovals `size` long and `aspect` as wide, falling at v, turning at spin,
// swaying `drift` units, spread up to `spread` units to each side.
fn fxFlakes(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, spread: f32, count: f32, v: f32, size: f32, aspect: f32, spin: f32, drift: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    // round 23: skipped only past where a flake's soft halo has faded (a flake sways `drift` past
    // `spread`, and its halo reaches about six sizes): cut there, it drew a hard dome round the
    // blade seen along it (Yavin Vines, players' reports after 2026.1021.1)
    if fxNear(ro, rd, y0 - 3.0, y1) > spread + abs(drift) + size * 6.0 + 1.0 {
        return acc;
    }
    var ta: f32;
    for (var i = 0; i < 24; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        let f = fract(uTime * v / (y1 - y0 + 4.0) * (0.7 + 0.6 * h11(fi * 2.7 + seed)) + h11(fi * 6.1 + seed));
        let y = mix(y1, y0 - 3.0, f);
        // round 19: all round the blade in three dimensions (they drifted in one flat sheet),
        // each flake a small oval facing the camera
        let rr = min(0.6 + (spread - 0.6) * h11(fi * 3.9 + seed) + drift * sin(uTime * 0.9 + fi * 2.0), 0.95 * uReach);
        let p = around(max(rr, 0.4), h11(fi * 4.3 + seed) + 0.03 * sin(uTime * 0.5 + fi), y);
        let d = rayPt(ro, rd, p, &ta);
        if d > size * 6.0 + px {
            continue;
        }
        let q = ro + rd * ta - p;
        let fu = normalize(cross(rd, select(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), abs(rd.y) < 0.9)));
        let e = rot(uTime * spin + fi * 1.7) * vec2(dot(q, fu), dot(q, cross(rd, fu)));
        let pd = length(e / vec2(size, size * aspect));
        acc += col * (halo(pd - 1.0, 0.3) * 0.8 + halo(d, size * 2.5) * 0.1) * smoothstep(0.0, 0.1, f) * (1.0 - smoothstep(0.85, 1.0, f));
    }
    return acc;
}

// Waves of light travelling up (or down, v < 0) the blade as rings round it, `count` at a
// time (up to 6), R across, each fading as it goes.
fn fxRingWaves(ro: vec3<f32>, rd: vec3<f32>, px: f32, y0: f32, y1: f32, count: f32, R: f32, v: f32, seed: f32, col: vec3<f32>) -> vec3<f32> {
    var acc: vec3<f32> = vec3<f32>(0.0);
    if fxNear(ro, rd, y0, y1) > R + 1.5 {
        return acc;
    }
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        if fi >= count {
            break;
        }
        var q = fract(uTime * v / (y1 - y0) + fi / max(count, 1.0) + seed);
        if v < 0.0 {
            q = 1.0 - q;
        }
        let y = mix(y0, y1, q);
        let d = ringD(ro, rd, y, min(R, 0.9 * uReach) * (0.7 + 0.3 * sin(3.1416 * q)));
        let env = sin(3.1416 * q);
        acc += (vec3<f32>(1.0) * halo(d, max(0.04, px)) * 0.7 + col * halo(d, 0.3) * 0.6 + col * halo(d, 1.0) * 0.08) * env;
    }
    return acc;
}

// ---- round 17: what circles the blade goes behind it ----
// How much of what is at `at` the blade's body leaves seen along this ray (in the hilt's frame):
// all of it in front of the blade, none of it behind (Creyon: Balance's orb of shadow showed
// through the blade).
fn bladeSeen(ro: vec3<f32>, rd: vec3<f32>, at: vec3<f32>) -> f32 {
    let L = uLength;
    var sAx: f32;
    var tAx: f32;
    var tAt: f32;
    _ = raySegRaw(ro, rd, vec3<f32>(0.0), vec3(0.0, L, 0.0), &sAx);
    let dAx = rayPtRaw(ro, rd, vec3(0.0, sAx * L, 0.0), &tAx);
    _ = rayPt(ro, rd, at, &tAt);
    // round 23: fading in behind the axis over a little depth, not at a hard step
    return 1.0 - (1.0 - smoothstep(0.35, 0.9, dAx)) * smoothstep(tAx - 0.4, tAx + 0.4, tAt);
}

// GLSL's mod: x - y * floor(x / y) (WGSL's % truncates)
fn glsl_mod(x: f32, y: f32) -> f32 {
    return x - y * floor(x / y);
}

// Quasar: the blinding heart of a galaxy drawn as a blade. The blade is a white-hot relativistic
// jet with bright knots racing up it, each throwing a shock ring round the blade. Low on the blade
// a real tilted accretion disk of glowing matter turns and slowly wobbles round a blinding core,
// brighter on the side rushing toward you, with streams of matter spiralling inward to the heart.
// From the tip the jet blasts on up into space, widening and fading, wrapped in twisting
// magnetic light, with sparks of plasma streaking out of it. Everything pulses with the engine's heartbeat. A swing feeds the engine (the
// disk flares and the jets lengthen); a clash fires a giant knot and a shockwave off the disk.
fn qs_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn qs_h() -> f32 {
    return uLength * 0.32 + 0.8 * sin(uTime * 0.3);
}

fn qs_beat() -> f32 {
    return 0.8 + 0.2 * sin(uTime * 3.2) + 0.25 * pow(0.5 + 0.5 * sin(uTime * 1.6), 8.0);
}

// a point or direction moved into the disk's own frame (tilted and slowly wobbling)
fn qs_loc(p_in: vec3<f32>) -> vec3<f32> {
    var p = p_in;
    let xy = rot(0.22 + 0.06 * sin(uTime * 0.5)) * p.xy;
    p = vec3(xy.x, xy.y, p.z);
    let zy = rot(0.16 * cos(uTime * 0.37)) * p.zy;
    return vec3(p.x, zy.y, zy.x);
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let top = qs_top();
    var s: f32;
    var tq: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let beat = qs_beat() * (1.0 + 0.4 * sw + 0.6 * cl);
    let vio: vec3<f32> = vec3<f32>(0.6, 0.38, 1.0);
    let white: vec3<f32> = vec3<f32>(1.0, 0.97, 1.0);
    // The jet is Sol's glow and core from the file, rippling (sig_glow, sig_core); here only
    // the effects, each a piece placed round it in 3D.
    let d: f32 = 0.0;
    var light: vec3<f32> = vec3<f32>(0.0);
    var fx: vec3<f32> = vec3<f32>(0.0);
    // knots racing up the jet, each with a ring of shocked light round the blade
    for (var i = 0; i < 6; i++) {
        let fi = f32(i);
        let ky = glsl_mod(uTime * 18.0 + fi * (L + 8.0) / 6.0, L + 8.0) - 1.0;
        if ky > top {
            continue;
        }
        let fade = smoothstep(-1.0, 1.5, ky) * (1.0 - smoothstep(L - 1.0, L, ky));
        let dk = raySegRaw(ro, rd, vec3(0.0, ky - 1.2, 0.0), vec3(0.0, ky + 0.4, 0.0), &s);
        light += white * (exp(-pow(dk / 0.55, 2.0)) * 1.4 + halo(dk, 1.3) * 0.3) * fade;
        let hr = rayAt(ro, rd, ky - 0.9);
        if hr.z > 0.0 {
            // round 23: hidden behind the blade softly (see hideD in lab.glsl)
            let rr = length(hr.xy);
            let seen = 1.0 - behindBlade(ro, rd, hr.z);
            let ring = halo(abs(rr - 1.0), max(0.05, px * 1.2)) * 1.3 + halo(abs(rr - 1.0), 0.35) * 0.25;
            fx += mix(white, vio, 0.4) * ring * fade * (1.0 - smoothstep(1.0, 2.2, rr)) * 0.9 * seen;
        }
    }
    // ---- the tip jet: blasting on up from the tip, widening, with shock diamonds and knots
    let jt = smoothstep(L - 2.0, L, top);
    if jt > 0.0 {
        let JL = 5.0 + 1.0 * sw + 0.6 * sin(uTime * 1.7);
        let dj = raySegRaw(ro, rd, vec3(0.0, top - 0.3, 0.0), vec3(0.0, top + JL, 0.0), &s);
        let w = 0.3 + 0.9 * s;
        let diamonds = 0.6 + 0.4 * sin(s * JL * 2.2 - uTime * 20.0);
        fx += (white * exp(-pow(dj / w, 2.0)) * 1.2 * diamonds + vio * halo(dj, w * 2.5) * 0.5) * pow(1.0 - s, 0.8) * 1.3 * jt * beat;
        // magnetic field lines twisting round the jet
        for (var k = 0; k < 2; k++) {
            let fk = f32(k);
            var prev = around(0.35, fk * 0.5 - uTime * 1.2, top);
            for (var i = 1; i <= 10; i++) {
                let u = f32(i) / 10.0;
                let p = around(0.35 + 1.5 * u, fk * 0.5 + u * 1.1 - uTime * 1.2, top + u * JL * 0.85);
                let dh = raySeg(ro, rd, prev, p, &s);
                let uu = (f32(i) - 1.0 + s) / 10.0;
                fx += vio * (halo(dh, max(0.04, px)) * 1.4 + halo(dh, 0.25) * 0.25) * (1.0 - uu) * jt * (0.6 + 0.4 * sin(uu * 12.0 - uTime * 10.0));
                prev = p;
            }
        }
        // sparks of plasma streaking out of the tip along the jet
        for (var i = 0; i < 4; i++) {
            let fi = f32(i);
            let f = fract(uTime * 0.9 + fi / 4.0);
            let sp = around(0.5 * f * (0.5 + h11(fi * 3.7 + floor(uTime * 0.9 + fi / 4.0))), h11(fi * 1.3 + floor(uTime * 0.9 + fi / 4.0)), top + f * JL);
            let dk = raySeg(ro, rd, sp - vec3(0.0, 1.2 + 1.5 * f, 0.0), sp, &s);
            fx += white * (halo(dk, max(0.04, px)) * 1.4 + halo(dk, 0.3) * 0.25) * (1.0 - f) * s * jt;
        }
    }
    // ---- the accretion disk round the blinding core
    let h = qs_h();
    let g = smoothstep(h - 1.0, h + 5.0, top);
    let c0 = vec3(0.0, h, 0.0);
    if g > 0.01 {
        let lo = qs_loc(ro - c0);
        let ld = qs_loc(rd);
        let spin = uTime * 1.4;
        // the disk: clumps of glowing matter orbiting on many rings in its tilted plane, brighter on
        // the side rushing toward you, each a short streak facing the camera
        if rayPt(lo, ld, vec3<f32>(0.0), &tq) < 7.5 * g {
            for (var i = 0; i < 44; i++) {
                let fi = f32(i);
                let r = (0.9 + 5.0 * pow(h11(fi * 3.9), 1.5)) * g;
                let a = h11(fi * 6.7) + spin * 0.4 / (0.4 + 0.35 * r) + 0.08 * sin(3.0 * log(r + 1.0));
                let p = around(r, a, 0.06 * (h11(fi * 2.1) - 0.5) * r);
                let q = around(r, a - 0.05 / (0.5 + 0.3 * r), p.y);
                let dk = raySeg(lo, ld, q, p, &s);
                let T = clamp(1.4 * g / r, 0.0, 1.0);
                let vt = normalize(vec3(cos(6.2832 * a), 0.0, -sin(6.2832 * a)));
                let bm = pow(1.0 + 0.55 * dot(vt, -ld), 3.0);
                fx += mix(vio, white, T * T) * (halo(dk, max(0.07 + 0.04 * r, px)) * 1.1 + halo(dk, 0.35 + 0.1 * r) * 0.25) * bm * (0.5 + 1.6 * T) * beat;
            }
            // its bright inner rim
            let tt = select(-1.0, -lo.y / ld.y, abs(ld.y) > 1.0e-4);
            if tt > 0.0 {
                let pp = lo + ld * tt;
                let rr = abs(length(pp.xz) - 0.75 * g);
                fx += white * (halo(rr, max(0.04, px)) * 1.4 + halo(rr, 0.3) * 0.4) * beat;
            }
        }
        // matter streaming inward on spirals across the disk, in bright pulses
        let dc = rayPt(ro, rd, c0, &tq);
        if dc < 7.0 {
            for (var k = 0; k < 3; k++) {
                let fk = f32(k);
                let a0 = fk / 3.0 - uTime * 0.22;
                var prev = vec3(5.6 * g * sin(6.2832 * a0), 0.0, 5.6 * g * cos(6.2832 * a0));
                for (var i = 1; i <= 14; i++) {
                    let u = f32(i) / 14.0;
                    let r = mix(5.6, 0.7, u) * g;
                    let a = a0 + u * 1.1;
                    let p = vec3(r * sin(6.2832 * a), 0.06 * sin(u * 9.0 + uTime * 3.0), r * cos(6.2832 * a));
                    let dh = raySeg(lo, ld, prev, p, &s);
                    let uu = (f32(i) - 1.0 + s) / 14.0;
                    let pulse = 0.3 + 0.7 * pow(0.5 + 0.5 * sin(uu * 16.0 - uTime * 9.0 + fk * 2.0), 4.0);
                    fx += mix(vio, white, uu) * (halo(dh, max(0.035, px)) * 0.9 + halo(dh, 0.25) * 0.4) * pulse * smoothstep(0.0, 0.2, uu) * g;
                    prev = p;
                }
            }
        }
        // the blinding core: white heat round the blade at the disk's heart, beating
        light += white * (halo(dc, 0.9) * 1.3 + halo(dc, 2.4) * 0.35) * beat * g;
        // a clash: a shockwave ring racing out across the disk
        if cl > 0.01 {
            let p0: vec3<f32> = vec3<f32>(0.0);
            let hp: vec3<f32> = vec3<f32>(0.0);
            let tt = select(-1.0, -lo.y / ld.y, abs(ld.y) > 1.0e-4);
            if tt > 0.0 {
                let pp = lo + ld * tt;
                let rr = abs(length(pp.xz) - 1.0 - 5.5 * (1.0 - cl));
                fx += white * (halo(rr, 0.12) * 1.8 + halo(rr, 0.6) * 0.35) * cl;
            }
            let dg = raySegRaw(ro, rd, vec3(0.0, L * 0.55, 0.0), vec3(0.0, L * 0.65, 0.0), &s);
            light += white * halo(dg, 1.2) * pow(cl, 2.0) * 1.6;
        }
    }
    light += fx * uFx;
    return light;
}

// the jet: Sol's glow and core from the file, rippling with the engine's heartbeat
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let beat = qs_beat() * (1.0 + 0.4 * clamp(uSwing, 0.0, 1.0) + 0.6 * clamp(uClash, 0.0, 1.0));
    return g * (0.8 + 0.2 * sin(b.y * 0.9 - uTime * 14.0)) * beat;
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    fx += fxFlare(ro, rd, vec3(0.0, L * 0.22, 0.0), px, 0.35, 5.0, 4.0, t * 0.25, vec3<f32>(0.6, 0.45, 1.0)) * (0.8 + 0.3 * sin(t * 3.0)) * part(1.0);
    return col + fx * uFx;
}

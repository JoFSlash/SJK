// Felucia Spores: the glowing fungal jungle of Felucia as a blade. A warm amber-green blade
// breathing with bioluminescent rings that pulse up it; glowing puffball spores rest on it while
// its wearer stands idle, lift off and swarm round it, following it, when they run or swing, and
// fly back to settle on it once they stand still (round 16); luminous filaments wave off its surface and now and then a spore pod bursts off it
// in a puff of light that rains spores. A swing brightens the spores; a clash bursts a huge cloud
// of them.
fn fs_top() -> f32 {
    return uLength * clamp(uAge / 0.45, 0.0, 1.0);
}

fn fs_col(k: f32) -> vec3<f32> {
    return select(select(vec3<f32>(0.25, 0.95, 0.8), vec3<f32>(0.7, 1.0, 0.25), k < 0.66), vec3<f32>(1.0, 0.75, 0.15), k < 0.33);
}

fn base_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let t = uTime;
    let top = fs_top();
    var s: f32;
    var ta: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    var col: vec3<f32> = vec3<f32>(0.0);
    if top < 0.5 {
        return col;
    }
    // drifting spore dust round it all the time
    col += fxMotes(ro, rd, px, top * 0.1, top, 1.0, 5.0, 24.0, 0.05, 2.7, vec3<f32>(0.8, 1.0, 0.4));
    // luminous filaments waving off the blade
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let y0 = (0.08 + 0.85 * h11(fi * 2.9)) * top;
        let a = h11(fi * 6.1);
        // 31/10/2026: a filament keeps within 2 of the axis between y0 - 0.4 and y0 + 1.2; its widest
        // glow is 0.18 (and a pixel's): a ray further off than three of them skips its five pieces
        if fxNear(ro, rd, y0 - 0.4, y0 + 1.2) - 2.0 > 0.6 + 3.0 * px {
            continue;
        }
        var prev = around(0.4, a, y0);
        var best: f32 = 1.0e3;
        var bu: f32 = 0.0;
        for (var j = 1; j <= 5; j++) {
            let u = f32(j) / 5.0;
            let q = around(0.4 + 1.6 * u, a + 0.06 * sin(t * 1.5 + fi + u * 3.0), y0 + 0.8 * u + 0.4 * sin(t * 2.0 + fi * 1.7 + u * 4.0) * u);
            let d = raySeg(ro, rd, prev, q, &s);
            if d < best {
                best = d;
                bu = (f32(j) - 1.0 + s) / 5.0;
            }
            prev = q;
        }
        col += fs_col(h11(fi * 4.4)) * (halo(best, max(0.03, px)) * 0.9 * (1.0 - bu) + halo(best, 0.18) * 0.15) + vec3<f32>(1.0, 1.0, 0.8) * halo(length(vec2(best, 0.0)), 0.06) * step(0.9, bu) * 1.2;
    }
    // spore pods bursting off it in a puff of light that rains spores
    for (var i = 0; i < 2; i++) {
        let fi = f32(i);
        let f = fract(t * 0.3 + fi * 0.5);
        let k = floor(t * 0.3 + fi * 0.5);
        let c = around(0.6 + 1.0 * f, h11(k * 3.7 + fi), (0.2 + 0.6 * h11(k * 1.9 + fi)) * top);
        let d = rayPt(ro, rd, c, &ta);
        col += vec3<f32>(1.0, 0.95, 0.6) * (halo(d, 0.4 + 2.0 * f) * 0.5 * (1.0 - f) + halo(abs(d - 3.0 * f), 0.15) * 0.6 * (1.0 - f));
    }
    // a clash: a huge cloud of spores
    if cl > 0.01 {
        for (var i = 0; i < 16; i++) {
            let fi = f32(i);
            let dir = normalize(vec3(sin(fi * 2.4), 0.8 * (h11(fi * 3.0) - 0.4), cos(fi * 2.4)));
            let p = vec3(0.0, uLength * 0.6, 0.0) + dir * (0.6 + 5.0 * (1.0 - cl));
            let d = rayPt(ro, rd, p, &ta);
            col += fs_col(h11(fi)) * halo(d, max(0.08, px)) * 2.0 * cl;
        }
    }
    // round 9: the jungle's light: soft beams of bioluminescence and a living aura
    let y0 = top * 0.2;
    let y1 = top * 0.97;
    col += fxAura(ro, rd, y0, y1, 3.0, vec3<f32>(0.8, 0.9, 0.3));
    return col * uFx;
}

// the blade: Sol's glow and core from the file, bioluminescent rings pulsing up it
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let ring = pow(0.5 + 0.5 * sin(b.y * 0.9 - uTime * 3.0), 6.0);
    return g * (0.85 + 0.6 * ring + 0.5 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c;
}

// round 11: sig_vol gated by part 0
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(0.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    // round 15 (Creyon): no longer a chroma (it hid the spores' colours); its own colours
    return base_vol(ro, rd, px);
}

// the spores circle the blade, so they are drawn in true 3D round it (`sig_orbit`, Sol's way)
fn fs_spores(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let t = uTime;
    let top = fs_top();
    var s: f32;
    var ta: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    var col: vec3<f32> = vec3<f32>(0.0);
    if top < 0.5 || fxNear(ro, rd, 0.0, top) > 6.5 {
        return col;
    }
    // spores (round 16, Creyon): they rest on the blade while its wearer stands idle; running or
    // swinging, they lift off and swarm round it, following it; standing still again they fly
    // back and settle on it. `uSince` carries how stirred the blade is, 0 to 1, smooth both ways
    // (`saber_motion.rs` `stir`, `blade_lab_designs.rs` `STIRRED`); each spore leaves and lands at
    // its own moment of it. Each is a puffball: a bright heart in a soft fuzzy ball with a fine
    // ring, trailing a little light when it flies.
    let stir = select(0.0, clamp(uSince, 0.0, 1.0), uSince <= 1.0);
    for (var i = 0; i < 40; i++) {
        let fi = f32(i);
        let hs = h11(fi * 6.3);
        var e = smoothstep(hs * 0.45, hs * 0.45 + 0.55, stir);
        e = e * e * (3.0 - 2.0 * e);
        let yr = (0.06 + 0.9 * h11(fi * 3.1)) * top;
        let ar = h11(fi * 1.3);
        let rest = 0.6 + 0.12 * h11(fi * 2.7) + 0.04 * sin(t * 1.7 + fi * 2.1);
        let sgn = select(1.0, -1.0, h11(fi * 9.3) < 0.5);
        let spin = (0.12 + 0.2 * h11(fi * 5.1)) * sgn;
        let rf = 1.6 + 3.0 * h11(fi * 7.7);
        let fly = around(rf + 0.3 * sin(t * 1.1 + fi), ar + t * spin, yr + 1.2 * sin(t * 0.7 + fi * 1.9) + 0.6);
        let fly0 = around(rf + 0.3 * sin(t * 1.1 - 0.2 + fi), ar + (t - 0.25) * spin, yr + 1.2 * sin((t - 0.25) * 0.7 + fi * 1.9) + 0.6);
        let rest3 = around(rest, ar, yr);
        let p = mix(rest3, fly, e);
        let p0 = mix(rest3, fly0, e);
        // 31/10/2026: its widest glow is 0.55 (its ring 0.04 round less than 0.4): a ray further than
        // three of them from the spore and its trail draws nothing of it
        if rayPtRaw(ro, rd, p, &ta) - length(p - p0) > 1.7 + 3.0 * px {
            continue;
        }
        let d = raySeg(ro, rd, p0, p, &s);
        let dp = rayPt(ro, rd, p, &ta);
        let tw = 0.7 + 0.3 * sin(t * (1.5 + 1.5 * h11(fi)) + fi * 2.0);
        let sc = fs_col(h11(fi * 8.8));
        let size = 0.16 + 0.08 * h11(fi * 4.4);
        col += (vec3<f32>(1.0) * halo(dp, max(0.05, px)) * (0.9 + 0.6 * tw) + sc * halo(dp, max(size, px)) * (1.3 + tw) + sc * halo(abs(dp - size * 1.6), 0.04) * 0.7 + sc * halo(dp, 0.55) * 0.25 + sc * halo(d, max(0.05, px)) * 0.7 * e) * (1.0 + 0.4 * sw);
    }
    return col;
}

fn sig_orbit(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(0.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    return fs_spores(ro, rd, px) * uFx;
}

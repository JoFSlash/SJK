// Big Bang: a blade that holds a young universe. Each ignition starts as one blinding point at the
// emitter that explodes: a sphere of light bursts outward and a fireball races up and lights the
// blade in half a second. Then the blade is a living cosmos: a white-hot core, shells of light
// rippling outward from it, soft nebula clouds swirling round it in three dimensions and a field of
// stars turning about it and drifting outward as space expands. Every so often a small new bang
// goes off somewhere along the blade, a spherical shockwave racing out. A swing stirs the gas and
// brightens the stars; a clash sets off a big bang flash.
// the blade lights in half a second behind a racing fireball
fn bb_top() -> f32 {
    return uLength * smoothstep(0.04, 0.48, uAge);
}

// a spherical shell of light (the ray's closest pass to its centre shows its bright rim)
fn bb_shell(ro: vec3<f32>, rd: vec3<f32>, c: vec3<f32>, R: f32, w: f32, dc: ptr<function, f32>) -> f32 {
    var t: f32;
    (*dc) = rayPt(ro, rd, c, &t);
    return halo(abs((*dc) - R), w) + 0.35 * smoothstep(max(R, 0.02), 0.0, (*dc));
}

// the ray's distance to a ring of radius R round the blade at height y
fn bb_ring(ro: vec3<f32>, rd: vec3<f32>, y: f32, R: f32) -> f32 {
    var best: f32 = 1.0e3;
    let h = rayAt(ro, rd, y);
    if h.z > 0.0 {
        best = hideD(abs(length(h.xy) - R), behindBlade(ro, rd, h.z));
    }
    let a = dot(rd.xz, rd.xz);
    let b = dot(ro.xz, rd.xz);
    let c = dot(ro.xz, ro.xz) - R * R;
    let dsc = b * b - a * c;
    if dsc > 0.0 && a > 1.0e-6 {
        let q = sqrt(dsc);
        let t0 = (-b - q) / a;
        let t1 = (-b + q) / a;
        if t0 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t0 - y), behindBlade(ro, rd, t0)));
        }
        if t1 > 0.0 {
            best = min(best, hideD(abs(ro.y + rd.y * t1 - y), behindBlade(ro, rd, t1)));
        }
    }
    return best;
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let t = uTime;
    let top = bb_top();
    let age = uAge;
    let st = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let fx = uFx;
    let white: vec3<f32> = vec3<f32>(1.0, 0.97, 0.95);
    let rose: vec3<f32> = vec3<f32>(1.0, 0.35, 0.72);
    let violet: vec3<f32> = vec3<f32>(0.55, 0.3, 1.0);
    let gold: vec3<f32> = vec3<f32>(1.0, 0.75, 0.45);
    let young = exp(-age * 2.5);
    var col: vec3<f32> = vec3<f32>(0.0);
    var s: f32;
    var ta: f32;
    // ---- the singularity and the first burst ----
    if age < 1.2 {
        let O: vec3<f32> = vec3<f32>(0.0, 0.4, 0.0);
        var dO: f32;
        let pre = smoothstep(0.0, 0.05, age) * (1.0 - smoothstep(0.06, 0.12, age));
        let burst = smoothstep(0.05, 0.08, age) * exp(-max(age - 0.06, 0.0) * 3.5);
        // the burst: an egg of light swelling out round the blade and racing up it with the fireball
        let ex = max(age - 0.05, 0.0);
        let Rh = 0.05 + 5.0 * (1.0 - exp(-ex * 7.0));
        let Ry = max(top + 2.0, Rh);
        let sc = vec3(1.0, Rh / Ry, 1.0);
        let rd2 = normalize(rd * sc);
        var tt: f32;
        let dS = rayPt(ro * sc - O * sc, rd2, vec3<f32>(0.0), &tt);
        let sh = halo(abs(dS - Rh), 0.3 + 0.25 * Rh / 5.0) + 0.35 * smoothstep(Rh, 0.0, dS);
        dO = rayPt(ro, rd, O, &ta);
        col += white * (halo(dO, 0.35) * pre * 6.0 + exp(-dO / 1.5) * pre * 1.5);
        col += mix(white, rose, smoothstep(0.0, 0.8, age)) * sh * burst * 1.3 * fx;
        // the fireball racing up the blade
        let fb = rayPtRaw(ro, rd, vec3(0.0, top, 0.0), &ta);
        col += mix(white, gold, 0.3) * (halo(fb, 0.8) * 2.0 + exp(-fb / 2.0) * 0.6) * (1.0 - smoothstep(0.4, 0.6, age)) * step(0.05, age);
    }
    if top < 0.1 {
        return col;
    }
    // The blade itself is Sol's glow and core from the skin's file (sig_glow, sig_core).
    let far = raySegRaw(ro, rd, vec3<f32>(0.0, -1.0, 0.0), vec3(0.0, top + 1.0, 0.0), &s);
    if fx <= 0.0 || far > 9.0 {
        return col;
    }
    // ---- nebula clouds: soft puffs of gas turning round the blade, inner ones faster ----
    for (var i = 0; i < 16; i++) {
        let fi = f32(i);
        let r = 1.0 + 3.2 * h11(fi * 5.3);
        let yy = (0.05 + 0.9 * h11(fi * 2.7)) * L;
        if yy > top + 1.0 {
            continue;
        }
        let p = around(r, h11(fi * 1.9) + t * 0.1 / (0.6 + 0.3 * r), yy + 1.2 * sin(t * 0.25 + fi * 1.3));
        let dd = rayPt(ro, rd, p, &ta);
        if dd > 4.0 {
            continue;
        }
        var k = h11(fi * 8.1);
        let gas = select(select(rose, violet, k < 0.66), vec3<f32>(0.3, 0.35, 1.0), k < 0.33);
        let br = 0.55 + 0.45 * sin(t * 0.9 + fi * 2.1);
        col += gas * (halo(dd, 0.7 + 0.6 * h11(fi * 3.3)) * 0.7 + halo(dd, 1.8) * 0.16) * br * (1.0 + 0.5 * st + 1.5 * young);
    }
    // ---- shells of light rippling outward from the blade, as rings round it ----
    for (var k = 0; k < 3; k++) {
        let f = fract(t * 0.28 + f32(k) / 3.0);
        let yr = (0.2 + 0.6 * h11(f32(k) * 4.1 + floor(t * 0.28 + f32(k) / 3.0))) * L;
        if yr > top {
            continue;
        }
        let R = 0.6 + 5.0 * f;
        let dr = bb_ring(ro, rd, yr, R);
        col += mix(white, rose, 0.4) * (halo(dr, max(0.05, px)) * 1.2 + halo(dr, 0.4) * 0.25) * (1.0 - f) * (1.0 - f) * smoothstep(0.0, 0.08, f);
    }
    // ---- stars turning round the blade and drifting outward as space expands ----
    for (var i = 0; i < 40; i++) {
        let fi = f32(i);
        let e = fract(h11(fi * 3.7) + t * 0.025);
        let r = 0.7 + 4.4 * e;
        let yy = h11(fi * 1.31) * (L + 1.0);
        if yy > top {
            continue;
        }
        let p = around(r, h11(fi * 7.9) + t * 0.12 / (0.5 + 0.35 * r), yy + 0.4 * sin(t * 0.3 + fi));
        let dd = rayPt(ro, rd, p, &ta);
        let tw = 0.65 + 0.35 * sin(t * (3.0 + 3.0 * h11(fi)) + fi * 1.7);
        let life = smoothstep(0.0, 0.12, e) * (1.0 - smoothstep(0.75, 1.0, e));
        let sc = mix(white, select(vec3<f32>(1.0, 0.85, 0.7), vec3<f32>(0.75, 0.82, 1.0), h11(fi * 2.3) < 0.5), 0.5);
        col += sc * (halo(dd, max(0.06, px)) * 2.2 + halo(dd, 0.28) * 0.18) * tw * life * (1.0 + 0.6 * st);
    }
    // ---- mini-bangs: a flash and a spherical shockwave somewhere along the blade ----
    for (var i = 0; i < 2; i++) {
        let fi = f32(i);
        let cyc = t / 2.6 + fi * 0.5;
        var k = floor(cyc);
        let q = fract(cyc) * 2.6;
        let yb = (0.15 + 0.75 * h11(k * 3.3 + fi * 7.1)) * L;
        if yb > top {
            continue;
        }
        let c = vec3(0.0, yb, 0.0);
        var dc: f32;
        let R = 4.8 * (1.0 - exp(-q * 2.2));
        let sh = bb_shell(ro, rd, c, R, 0.12 + 0.12 * R, &dc);
        let fade = exp(-q * 1.4) * smoothstep(0.0, 0.05, q);
        col += (mix(white, rose, smoothstep(0.0, 1.2, q)) * sh * 1.2 + white * halo(dc, 0.6) * exp(-q * 6.0) * 2.0) * fade;
    }
    // ---- clash: a big bang ----
    if cl > 0.01 {
        let a = 1.0 - cl;
        var dc: f32;
        let sh = bb_shell(ro, rd, vec3(0.0, min(L * 0.6, top), 0.0), 0.5 + 5.5 * (1.0 - exp(-a * 4.0)), 0.5, &dc);
        col += white * (halo(dc, 1.8) * 3.5 + halo(dc, 3.4) * 1.2) * cl * cl + mix(white, rose, a) * sh * cl * 1.4;
    }
    return col;
}

// the blade: Sol's glow and core from the file, heated where a small bang goes off
fn bb_mb(y: f32) -> f32 {
    var mb: f32 = 0.0;
    for (var i = 0; i < 2; i++) {
        let fi = f32(i);
        let cyc = uTime / 2.6 + fi * 0.5;
        let k = floor(cyc);
        let q = fract(cyc) * 2.6;
        let yb = (0.15 + 0.75 * h11(k * 3.3 + fi * 7.1)) * uLength;
        mb += exp(-pow((y - yb) / 1.4, 2.0)) * exp(-q * 3.0);
    }
    return mb + exp(-uAge * 2.5) + 0.5 * clamp(uClash, 0.0, 1.0);
}

fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return g * (0.9 + 0.1 * sin(uTime * 1.7 - b.y * 0.35) + bb_mb(b.y) + 0.3 * uSwing);
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * (1.0 + 0.6 * bb_mb(b.y));
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    let pink: vec3<f32> = vec3<f32>(1.0, 0.45, 0.85);
    let blue: vec3<f32> = vec3<f32>(0.45, 0.6, 1.0);
    for (var i = 0; i < 4; i++) {
        let fi = f32(i);
        let cyc = t * 0.35 + fi * 0.25;
        let k = floor(cyc);
        let q = fract(cyc);
        let p = around(1.5 + 4.0 * h11(k * 3.1 + fi), h11(k * 1.7 + fi * 2.0), mix(y0, y1, h11(k * 5.3 + fi)));
        fx += fxFlare(ro, rd, p, px, 0.18, 2.8, 6.0, t * 0.3 + fi, mix(pink, blue, h11(k + fi))) * sin(3.1416 * q) * part(1.0);
    }
    return col + fx * uFx;
}

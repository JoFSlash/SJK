// @room 10
// @solid 1
// @palette {"corona.rim_cool":[0.04,0.35,0.08],"corona.rim_hot":[0.35,1.0,0.35],"corona.inner":[0.8,1.0,0.75],"core.white":[0.92,1.0,0.9],"core.fringe_cool":[0.2,0.85,0.3],"core.fringe_hot":[0.7,1.0,0.6],"light.color":[0.3,1.0,0.35],"trail":[0.35,1.0,0.4]}

// Witchfire: the Nightsister magick of Dathomir, as a blade. The blade is a column of sickly green
// witchfire ichor with a pale burning heart, wrapped all round in swirling green ghost-fire whose
// tongues lick up its length. Thick ichor mist pours down off it and spills over the hilt, three
// tendrils of green energy coil round it and slide upward, dark smoke curls through the fire, and
// pulses of magick climb the blade from the hilt to the tip. Swinging feeds the fire; a clash
// blasts it outward in a ring of green flame (round 15: no lightning, which made it look like the
// Sith Alchemy and Superlaser blades; the ghost-fire is its own).
const WF_G: vec3<f32> = vec3<f32>(0.10, 1.0, 0.09);

const WF_DEEP: vec3<f32> = vec3<f32>(0.02, 0.50, 0.05);

const WF_PALE: vec3<f32> = vec3<f32>(0.78, 1.0, 0.62);

fn wf_top() -> f32 {
    let g = clamp(uAge / 0.45, 0.0, 1.0);
    return uLength * (1.0 - (1.0 - g) * (1.0 - g));
}

// pulses of magick climbing the blade
fn wf_pulse(y: f32) -> f32 {
    let f = fract(y * 0.045 - uTime * 0.7);
    return pow(f, 10.0) * smoothstep(1.0, 0.97, f) * 2.0;
}

// one coiling tendril of green energy
fn wf_tendril(ro: vec3<f32>, rd: vec3<f32>, k: f32, px: f32, top: f32) -> vec3<f32> {
    var best: f32 = 1.0e3;
    var bs: f32 = 0.0;
    var s: f32;
    var prev: vec3<f32> = vec3<f32>(0.0);
    let ph = k / 3.0 + uTime * 0.12;
    let slide = uTime * 0.9 + k * 4.0;
    for (var i = 0; i <= 20; i++) {
        let f = f32(i) / 20.0;
        let y = f * top * 1.02 - 0.3;
        let rr = 0.9 + 0.8 * (0.5 + 0.5 * sin(f * 7.0 + k * 2.1 - uTime * 1.3)) + uSwing * 0.6;
        let q = around(rr, ph + f * (1.3 + 0.25 * k), y);
        if i > 0 {
            let d = raySeg(ro, rd, prev, q, &s);
            if d < best {
                best = d;
                bs = (f32(i) - 1.0 + s) / 20.0;
            }
        }
        prev = q;
    }
    // energy sliding along it
    let flow = 0.45 + 0.55 * pow(0.5 + 0.5 * sin((bs * top - slide * 6.0) * 0.35), 3.0);
    let fade = smoothstep(0.0, 0.08, bs) * (1.0 - smoothstep(0.88, 1.0, bs));
    return (WF_PALE * halo(best, max(px, 0.03)) * 0.6 + WF_G * halo(best, 0.14) * 0.8 + WF_G * halo(best, 0.6) * 0.18) * flow * fade;
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let top = wf_top();
    let cl = clamp(uClash, 0.0, 1.0);
    var col: vec3<f32> = vec3<f32>(0.0);
    // The ichor blade is Sol's glow and core from the file with pulses of magick climbing it
    // (sig_glow, sig_core); here only the effects, each a piece placed round it in 3D.
    var sa: f32;
    let dax = raySegRaw(ro, rd, vec3<f32>(0.0, -0.6, 0.0), vec3(0.0, top, 0.0), &sa);
    let hot = 1.0 + uSwing * 0.6 + cl * 0.8;
    // ghost-fire: green tongues licking up off the blade, swirling round it
    for (var i = 0; i < 24; i++) {
        let fi = f32(i);
        let rate = 0.8 + 0.5 * h11(fi * 2.3);
        let f = fract(uTime * rate + h11(fi * 6.7));
        var k = floor(uTime * rate + h11(fi * 6.7));
        let y0 = (0.02 + 0.92 * h11(fi * 3.1 + k)) * top;
        let a0 = h11(fi * 5.3 + k) + uTime * 0.22;
        let p0 = around(0.4, a0, y0 + 2.0 * f);
        let p1 = around(0.6 + (1.2 + 1.6 * h11(fi * 9.1)) * f * hot, a0 + 0.08 * f, y0 + 2.0 * f + 1.3);
        var sk: f32;
        let dk = raySeg(ro, rd, p0, p1, &sk);
        if dk > 2.0 {
            continue;
        }
        let w = max(0.12 + 0.25 * (1.0 - sk) * (1.0 - f), px);
        let pu2 = wf_pulse(p0.y);
        col += (WF_G * halo(dk, w) * 0.9 * (1.0 + pu2) + WF_PALE * halo(dk, w * 0.3) * 0.4) * sin(3.1416 * f) * (1.0 - 0.5 * sk) * uFx;
    }
    // ichor mist pouring down the blade and spilling over the hilt
    for (var i = 0; i < 12; i++) {
        let fi = f32(i);
        let f = fract(uTime * (0.25 + 0.1 * h11(fi * 1.7)) + h11(fi * 8.3));
        let y0 = (0.15 + 0.8 * h11(fi * 4.1)) * top;
        let yy = mix(y0, -2.5, f);
        let sp = 1.0 - clamp(yy / uLength, 0.0, 1.0);
        let p = around(0.6 + 2.2 * sp * sp * f + 0.4 * f, h11(fi * 2.9) + 0.1 * f, yy);
        var tt: f32;
        let dm = rayPt(ro, rd, p, &tt);
        col += WF_DEEP * (halo(dm, 0.5 + 0.8 * f) * 0.45 + halo(dm, 1.5) * 0.08) * sin(3.1416 * f) * uFx;
    }
    // tendrils
    if dax < 3.4 {
        var td: vec3<f32> = vec3<f32>(0.0);
        for (var k = 0; k < 3; k++) {
            td += wf_tendril(ro, rd, f32(k), px, top);
        }
        col += td * uFx;
    }
    // clash: a ring of green flame blasts out
    if cl > 0.0 {
        let h = rayAt(ro, rd, uLength * 0.6);
        if h.z > 0.0 {
            // round 23: hidden behind the blade softly (see hideD in lab.glsl)
            let rr = length(h.xy);
            let aa = atan2(h.x, h.y);
            let seen = 1.0 - behindBlade(ro, rd, h.z);
            let R = 0.5 + (1.0 - cl) * 5.0;
            let tongue = 0.6 + 0.4 * vn(vec2(aa * 4.0, uTime * 8.0));
            col += (WF_G * halo(abs(rr - R), 0.5 * tongue) + WF_PALE * halo(abs(rr - R), 0.12)) * cl * 1.5 * uFx * seen;
        }
    }
    return col;
}

// dark smoke curling through the fire: dim puffs drifting up round it, each facing the camera
fn sig_vol_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    let top = wf_top();
    if uFx < 0.5 {
        return vec4<f32>(0.0);
    }
    var al: f32 = 0.0;
    for (var i = 0; i < 10; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.12 + h11(fi * 3.9));
        let p = around(1.5 + 1.2 * h11(fi * 6.1) + 0.6 * f, h11(fi * 2.2) + uTime * 0.1, (0.1 + 0.85 * h11(fi * 7.7)) * top + 3.0 * f);
        var tt: f32;
        let d = rayPt(ro, rd, p, &tt);
        al = max(al, halo(d, 0.6 + 0.5 * f) * 0.45 * sin(3.1416 * f));
    }
    return vec4(vec3<f32>(0.01, 0.025, 0.012), al);
}

// the blade: Sol's glow and core from the file, wobbling, pulses of magick climbing it
fn sig_glow_own(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let pu = wf_pulse(b.y);
    return g * (0.85 + 0.15 * sin(b.y * 1.7 - uTime * 6.0) + 0.8 * pu + 0.6 * clamp(uClash, 0.0, 1.0));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * (1.0 + 0.3 * wf_pulse(b.y));
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    var fx: vec3<f32> = vec3<f32>(0.0);
    fx += fxAura(ro, rd, y0, y1, 3.0, vec3<f32>(0.3, 1.0, 0.35)) * part(0.0);
    return col + fx * uFx;
}

// round 15 (Creyon: some blades glowed so much their effects hardly showed): its glow at
// 80 %, so what is drawn round it reads
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    return sig_glow_own(g, b, r, px) * 0.8;
}

// @part Totality
// @part Eclipsed suns
// @arcs Prominences
// @room 10
// @solid 1
// @palette {"corona.rim_cool":[0.75,0.62,0.40],"corona.rim_hot":[1.0,0.90,0.70],"corona.inner":[1.0,0.97,0.90],"core.white":[1.0,0.98,0.92],"core.fringe_cool":[0.95,0.75,0.45],"core.fringe_hot":[1.0,0.92,0.75],"light.color":[1.0,0.86,0.62],"trail":[1.0,0.84,0.58]}

// Eclipse: a thin blade (pearl-white, or its wearer's colour: a chroma) with a total eclipse
// travelling along it. Where the moon passes, a dark ring crosses the blade and its light goes
// out in a band. The band drifts slowly up and down the blade, with diamond-ring flashes and
// Baily's beads sparking on its edge, while small pearly prominences loop up off the blade and
// fade, and the stars of totality come out round the band. Ignites fast; a clash flares the
// band with a diamond-ring burst.
fn ec_top() -> f32 {
    return uLength * clamp(uAge / 0.4, 0.0, 1.0);
}

// the band's height: drifting up and down the blade, rising out of the hilt at ignition
fn ec_y() -> f32 {
    let L = uLength;
    // kept in the blade's upper half, clear of its wearer's head and body (Creyon's round 9)
    let y = L * (0.7 + 0.16 * sin(uTime * 0.3 + uSeed * 6.0));
    return mix(L * 0.5, y, smoothstep(0.2, 1.2, uAge));
}

fn ec_hw() -> f32 {
    return 1.4;
}

fn ec_ringR() -> f32 {
    return 0.55;
}

// how dark the blade is at height y (1 in the band)
fn ec_shade(y: f32) -> f32 {
    let yb = ec_y();
    let hw = ec_hw();
    return (1.0 - smoothstep(hw * 0.45, hw * 0.8, abs(y - yb))) * smoothstep(0.0, 0.5, uAge);
}

// the eclipsed suns: three dark moons, each in front of its own small sun, orbiting the blade
// in 3D like the Void's black holes: centre and radius of orb i
fn ec_orbAt(i: f32, tt: f32, R: ptr<function, f32>) -> vec3<f32> {
    let L = uLength;
    (*R) = 0.9 + 0.25 * i;
    let a = i / 3.0 + tt * (0.12 + 0.05 * i) * (select(1.0, -1.0, i == 1.0));
    let y = L * (0.5 + 0.17 * i) + 1.0 * sin(tt * 0.4 + i * 2.0);
    return around(3.4 + 0.4 * i, a, y);
}

fn ec_orb(i: f32, R: ptr<function, f32>) -> vec3<f32> {
    return ec_orbAt(i, uTime, R);
}

// a point's place in the plane facing the camera round centre c: (across, up) and distance
fn ec_face(ro: vec3<f32>, rd: vec3<f32>, c: vec3<f32>) -> vec3<f32> {
    var t: f32;
    let d = rayPt(ro, rd, c, &t);
    let off = ro + rd * t - c;
    let ux = normalize(cross(rd, vec3<f32>(0.0, 1.0, 0.0)) + vec3<f32>(1.0e-4, 0.0, 0.0));
    let uy = cross(ux, rd);
    return vec3(dot(off, ux), dot(off, uy), d);
}

fn r8_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let L = uLength;
    let top = ec_top();
    var s: f32;
    var tq: f32;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let flare = max(cl, exp(-uAge * 1.6) * step(0.0, uAge) * 0.35);
    let pearl: vec3<f32> = vec3<f32>(1.0, 0.9, 0.72);
    let white: vec3<f32> = vec3<f32>(1.0, 0.98, 0.94);
    let yb = ec_y();
    let hw = ec_hw();
    let R0 = ec_ringR();
    // The blade is Sol's glow and core from the file, dark in the moon's band (sig_glow,
    // sig_core, sig_solid); here only the effects, each a piece placed round it in 3D.
    var light: vec3<f32> = vec3<f32>(0.0);
    var fx: vec3<f32> = vec3<f32>(0.0);
    let vis = smoothstep(0.1, 0.6, uAge);
    // (round 14, Creyon: no corona of streamers round the band; instead) the stars of totality:
    // as the band darkens the sky, small stars come out round it and twinkle, the nearest the band
    // the brightest
    for (var i = 0; i < 22; i++) {
        let fi = f32(i);
        let sp = around(1.2 + 4.2 * h11(fi * 2.9), h11(fi * 6.3), yb + (h11(fi * 4.1) - 0.5) * 7.0);
        let ds = rayPt(ro, rd, sp, &tq);
        let tw = 0.55 + 0.45 * sin(uTime * (1.5 + 2.0 * h11(fi * 8.3)) + fi * 3.7);
        let near = 1.0 - smoothstep(2.0, 4.5, abs(sp.y - yb));
        fx += mix(white, vec3<f32>(0.75, 0.85, 1.0), h11(fi * 1.1)) * (halo(ds, max(0.04, px)) * 1.6 + halo(ds, 0.18) * 0.25) * tw * near * vis;
    }
    // ---- solar wind: pearly motes streaming out from the band and the suns
    for (var i = 0; i < 18; i++) {
        let fi = f32(i);
        let f = fract(uTime * 0.35 + h11(fi * 3.3));
        let a = h11(fi * 7.1 + floor(uTime * 0.35 + h11(fi * 3.3)));
        let p = around(0.6 + 5.0 * f, a + 0.1 * f, yb + (h11(fi * 5.9) - 0.5) * 2.5 * f);
        let dm = rayPt(ro, rd, p, &tq);
        fx += white * halo(dm, max(0.05, px)) * 1.2 * sin(3.1416 * f) * vis;
    }
    // ---- the chromosphere: thin bright rims along both edges of the band, round the blade
    for (var k = 0; k < 2; k++) {
        let ey = yb + (f32(k) * 2.0 - 1.0) * hw * 0.62;
        let hp = rayAt(ro, rd, ey);
        if hp.z > 0.0 {
            // round 23: hidden behind the blade softly (see hideD in lab.glsl)
            let rr = length(hp.xy);
            let seen = 1.0 - behindBlade(ro, rd, hp.z);
            let rim = halo(abs(rr - 0.42), max(0.05, px)) * 1.1;
            fx += white * rim * vis * (1.0 - smoothstep(0.6, 1.2, rr)) * seen;
        }
    }
    // ---- diamond ring and Baily's beads: flashes on the band's edge as the moon slides
    let cyc = uTime * 0.45;
    let f = fract(cyc);
    let id = floor(cyc);
    let fl = exp(-f * 5.0) * smoothstep(0.0, 0.03, f) + flare * 0.8;
    let upper = select(-1.0, 1.0, h11(id * 3.7) < 0.5);
    let a0 = h11(id * 1.9);
    let dp = around(0.42, a0, yb + upper * hw * 0.62);
    let dd = rayPt(ro, rd, dp, &tq);
    fx += white * (halo(dd, 0.12) * 2.5 + halo(dd, 0.6) * 0.6 + halo(dd, 2.0) * 0.15) * fl * vis;
    // a soft horizontal flash streak through the diamond, round the band
    let hp2 = rayAt(ro, rd, dp.y);
    if hp2.z > 0.0 {
        let rr = length(hp2.xy);
        let seen = 1.0 - behindBlade(ro, rd, hp2.z);
        fx += white * halo(abs(rr - 0.42), 0.25) * exp(-rr / 2.5) * fl * 0.6 * vis * seen;
    }
    for (var j = 0; j < 5; j++) {
        let fj = f32(j);
        let bp = around(0.42, a0 + (fj + 1.0) * 0.07 * upper, dp.y);
        let db = rayPt(ro, rd, bp, &tq);
        let tw = 0.6 + 0.4 * sin(uTime * 13.0 + fj * 2.1);
        fx += white * halo(db, 0.07) * 1.6 * tw * exp(-f * 3.0) * (1.0 - fj * 0.15) * vis;
    }
    // ---- prominences: pearly loops of plasma arching off the blade, rising and lifting away
    let dA = raySegRaw(ro, rd, vec3<f32>(0.0, 0.0, 0.0), vec3(0.0, top, 0.0), &s);
    if dA < 4.5 {
        for (var i = 0; i < 4; i++) {
            let fi = f32(i);
            let ph = uTime * (0.25 + 0.1 * h11(fi * 3.3)) + h11(fi * 8.1);
            let cy = floor(ph);
            let fp = fract(ph);
            var y0 = (0.1 + 0.8 * h11(cy * 1.9 + fi * 3.0)) * top;
            if abs(y0 - yb) < hw + 1.0 {
                continue;
            }
            let az = h11(cy * 2.7 + fi);
            let span = 0.5 + 0.6 * h11(cy + fi * 5.0);
            // round 19 (Creyon: a prominence rose past the tip): each loop ends below the tip
            y0 = min(y0, top - 1.2 - span * 2.0);
            let H = (0.45 + 0.5 * h11(cy * 4.1 + fi)) * smoothstep(0.0, 0.35, fp) * (1.0 + 0.8 * max(fp - 0.5, 0.0));
            let life = smoothstep(0.0, 0.1, fp) * (1.0 - smoothstep(0.7, 1.0, fp));
            var prev = around(0.35, az, y0);
            for (var j = 1; j <= 10; j++) {
                let u = f32(j) / 10.0;
                let lift: f32 = 0.0;
                let p = around(0.35 + H * sin(u * 3.1416) + lift, az + 0.03 * sin(u * 3.1416 * 2.0) * H, y0 + span * u * 2.0);
                let dh = raySeg(ro, rd, prev, p, &s);
                let strand = 0.65 + 0.35 * sin((f32(j) + s) * 2.0 - uTime * 4.0 + fi);
                fx += mix(white, pearl, 0.6) * (halo(dh, max(0.06, px)) * 0.8 + halo(dh, 0.3) * 0.4) * life * strand;
                prev = p;
            }
        }
    }
    light += fx * uFx;
    return light;
}

// the orbiting moons' dark discs, each a disc facing the camera, in true 3D
// round 10: the eclipsed suns circle the blade, so they alone are drawn in true 3D
// (Sol's way: only what orbits is 3D, everything else flat)
fn base_orbit(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let top = ec_top();
    var tq: f32;
    let cl = clamp(uClash, 0.0, 1.0);
    let flare = max(cl, exp(-uAge * 1.6) * step(0.0, uAge) * 0.35);
    let pearl: vec3<f32> = vec3<f32>(1.0, 0.9, 0.72);
    let white: vec3<f32> = vec3<f32>(1.0, 0.98, 0.94);
    var fx: vec3<f32> = vec3<f32>(0.0);
    let vis = smoothstep(0.1, 0.6, uAge);
    // ---- the eclipsed suns orbiting the blade: a black moon rimmed by a blazing corona with
    // streamers, a diamond-ring flash, beads of light and a pearly wake behind each
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        var R: f32;
        let c = ec_orb(fi, &R);
        if c.y > top + 2.0 {
            continue;
        }
        let f = ec_face(ro, rd, c);
        if f.z > R * 6.0 {
            continue;
        }
        let ang = atan2(f.y, f.x);
        let rr = f.z / R;
        let strm = pow(0.5 + 0.5 * sin(ang * 7.0 + uTime * 0.3 + fi * 2.0), 3.0) * 0.7 + pow(0.5 + 0.5 * sin(ang * 13.0 - uTime * 0.5 + fi), 6.0) * 0.5;
        let cor = exp(-max(rr - 1.0, 0.0) * (1.1 - 0.7 * strm)) * smoothstep(0.95, 1.02, rr) * (1.0 - smoothstep(3.0, 5.5, rr));
        let rim = halo(abs(rr - 1.02), 0.04 + px / R);
        let spin = uTime * 0.9 + fi * 2.1;
        let dia = pow(max(cos(ang - spin), 0.0), 60.0) * halo(abs(rr - 1.0), 0.15);
        fx += (pearl * cor * (1.6 + 0.8 * flare) + white * rim * 2.2 + white * dia * 4.0 + white * halo(abs(rr - 1.0), 0.6) * pow(max(cos(ang - spin), 0.0), 8.0) * 0.6) * vis;
        // beads of light circling the rim
        for (var j = 0; j < 5; j++) {
            let aj = spin + 0.4 + f32(j) * 0.25;
            let bp = vec2(cos(aj), sin(aj)) * R * 1.02;
            let db = length(f.xy - bp);
            fx += white * halo(db, max(0.05, px)) * 1.4 * (0.6 + 0.4 * sin(uTime * 9.0 + f32(j))) * vis;
        }
        // a pearly wake trailing the orbit
        for (var j = 1; j <= 6; j++) {
            let lag = f32(j) * 0.018 * (select(1.0, -1.0, fi == 1.0));
            var Rw: f32;
            let cw = ec_orbAt(fi, uTime - f32(j) * 0.25, &Rw);
            let dw = rayPt(ro, rd, cw, &tq);
            fx += pearl * halo(dw, 0.35 * (1.0 - f32(j) / 7.0) + 0.05) * 0.35 * (1.0 - f32(j) / 7.0) * vis;
        }
    }
    return fx * uFx;
}

fn base_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    var o: vec4<f32> = vec4<f32>(0.0);
    let top = ec_top();
    for (var i = 0; i < 3; i++) {
        let fi = f32(i);
        var R: f32;
        let c = ec_orb(fi, &R);
        if c.y > top + 2.0 {
            continue;
        }
        let f = ec_face(ro, rd, c);
        let a = fillD(f.z - R, px) * smoothstep(0.2, 0.6, uAge);
        o = vec4(mix(o.rgb, vec3<f32>(0.01, 0.008, 0.006), a), max(o.a, a));
    }
    return o;
}

// the moon's shadow, drawn over Sol's glow as his solid blades are: the blade's heart goes
// dark across the band
fn sig_solid(o: vec4<f32>, b: vec2<f32>, px: f32) -> vec4<f32> {
    let a = (1.0 - smoothstep(0.22, 0.42, abs(b.x))) * ec_shade(b.y) * smoothstep(0.1, 0.5, uAge);
    return vec4(mix(o.rgb, vec3<f32>(0.02, 0.018, 0.015), a * 0.9), max(o.a, a * 0.9));
}

// the blade: Sol's glow and core from the file, light running up it, out in the band
fn sig_glow(g: vec3<f32>, b: vec2<f32>, r: f32, px: f32) -> vec3<f32> {
    let sheen = 0.85 + 0.15 * sin(b.y * 1.3 - uTime * 6.0) + 0.1 * sin(b.y * 0.37 + uTime * 2.3);
    return g * sheen * (1.0 - 0.94 * ec_shade(b.y));
}

fn sig_core(c: vec3<f32>, b: vec2<f32>, px: f32) -> vec3<f32> {
    return c * (1.0 - 0.94 * ec_shade(b.y));
}

// ---- round 9: the big effects layer ----
// Round 11 (Creyon): its own look, Sol's way: its round-8 effects as part 0, its own parts
// (`part(k)`, the `// @part` lines) and Sol's pieces from its file; nothing shared with the others.
fn sig_vol(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    let col = r8_vol(ro, rd, px) * part(0.0);
    let L = uLength;
    let t = uTime;
    let sw = clamp(uSwing, 0.0, 1.0);
    let cl = clamp(uClash, 0.0, 1.0);
    let y0 = L * 0.2;
    let y1 = L * 0.97;
    let fx: vec3<f32> = vec3<f32>(0.0);
    // round 14 (Creyon): a chroma for the blade only; the corona and the suns keep their own
    // pearly colours (uKeep, uOwn), as Kyber Cluster's crystals do
    uKeep += col + fx * uFx;
    return vec3<f32>(0.0);
}

// round 11: sig_orbit gated by part 1; round 14 (Creyon): the eclipsed suns' glow takes the
// wearer's colour with the blade (their moons stay black, `sig_orbit_solid`)
fn sig_orbit(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec3<f32> {
    if part(1.0) < 0.5 {
        return vec3<f32>(0.0);
    }
    return base_orbit(ro, rd, px);
}

// round 11: sig_orbit_solid gated by part 1
fn sig_orbit_solid(ro: vec3<f32>, rd: vec3<f32>, px: f32) -> vec4<f32> {
    if part(1.0) < 0.5 {
        return vec4<f32>(0.0);
    }
    let o = base_orbit_solid(ro, rd, px);
    uOwn = max(uOwn, o.a);
    return o;
}
